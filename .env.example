# Cloudinary (for Tina CMS media uploader)
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Tina Cloud (for branch, auth; get from tina.io)
# NEXT_PUBLIC_TINA_CLIENT_ID=
# TINA_TOKEN=

# Google Analytics 4. Optional. Read at build time; a rebuild is required after changing it.
# Leave unset to omit the tag.
PUBLIC_GOOGLE_ANALYTICS_ID=G-YZVS3RE5GW

# Sitemap <loc> origin. Defaults to http://localhost:4321 so a local crawl matches.
# The Netlify build sets this to https://www.phandc.net. Uncomment to build a production sitemap locally.
# SITEMAP_SITE=https://www.phandc.net
