{
  "name": "phc",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:site\"",
    "dev:api": "cross-env NODE_ENV=development node scripts/dev-api.mjs",
    "dev:site": "tinacms dev -c \"astro dev\"",
    "build": "npm run generate:redirects && astro build",
    "build:admin": "tinacms build",
    "preview": "astro preview",
    "scrape": "node scripts/scrape-phandc.mjs",
    "spider": "node scripts/scrape-phandc.mjs",
    "generate:portfolio": "node scripts/generate-portfolio-from-scrape.mjs",
    "generate:about": "node scripts/generate-about-from-scrape.mjs",
    "generate:pages": "node scripts/generate-pages-from-scrape.mjs",
    "generate:redirects": "node scripts/generate-redirects.mjs",
    "sync:cloudinary": "node --import dotenv/config scripts/sync-assets-to-cloudinary.mjs",
    "export:portfolio": "node scripts/export-portfolio-csv.mjs",
    "import:portfolio": "node scripts/import-portfolio-csv.mjs",
    "clean:descriptions": "node scripts/clean-portfolio-descriptions.mjs",
    "migrate:tags": "node scripts/migrate-tags.mjs --write",
    "migrate:tags:dry": "node scripts/migrate-tags.mjs",
    "migrate:tags:split": "node scripts/migrate-tags-split.mjs --write",
    "migrate:tags:split:dry": "node scripts/migrate-tags-split.mjs",
    "generate:services-doc": "node scripts/generate-services-doc.mjs",
    "generate:service-tags": "node scripts/generate-service-tags.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tinacms/auth": "^1.1.3",
    "astro": "^5.0.0",
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.3.2",
    "fs-extra": "^11.3.4",
    "next-tinacms-cloudinary": "^27.0.4",
    "serverless-http": "^4.0.0",
    "tinacms": "^3.12.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tinacms/cli": "^2.6.1",
    "cloudinary": "^2.5.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "tailwindcss": "^4.0.0",
    "turndown": "^7.2.0",
    "vite": "^6.0.0"
  }
}
