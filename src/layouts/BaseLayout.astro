---
import JsonLd from "@/components/seo/JsonLd.astro";
import Footer from "@/components/Footer.astro";
import {
  createGraphSchema,
  createOrganizationSchema,
  createWebPageSchema,
  createWebSiteSchema,
  toAbsoluteUrl,
} from "@/lib/seo/jsonld";
import { getImageUrl } from "@/lib/cloudinary";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLdNodes?: Record<string, unknown>[];
  ogType?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title = "PH&C",
  description,
  image,
  jsonLdNodes = [],
  ogType = 'website',
  datePublished,
  dateModified,
} = Astro.props as Props;
import '../styles/global.css';

const displayTitle = title.startsWith('PH&C - ') || title.startsWith('PH&C – ') ? title : `PH&C - ${title}`;
const site = Astro.url.origin || import.meta.env.SITE || 'https://phandc.net';
const canonicalUrl = new URL(Astro.url.pathname, site).href.replace(/\/$/, '') || site;
const ogImageSource = image
  ? getImageUrl(image, { width: 1200, height: 630, crop: 'fill', quality: 'auto:eco' })
  : '/images/logo-light.png';
const absoluteImageUrl = toAbsoluteUrl(ogImageSource, site);
const baseJsonLd = createGraphSchema([
  createOrganizationSchema(site),
  createWebSiteSchema(site),
  createWebPageSchema({
    site,
    url: Astro.url.href,
    name: displayTitle,
    description,
    image: absoluteImageUrl,
    datePublished,
    dateModified,
  }),
  ...jsonLdNodes,
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="PH&C" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    {description && <meta property="og:description" content={description} />}
    {ogType === 'article' && datePublished && (
      <meta property="article:published_time" content={datePublished} />
    )}
    {ogType === 'article' && dateModified && (
      <meta property="article:modified_time" content={dateModified} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={absoluteImageUrl} />
    <link rel="preload" href="/fonts/Italian Old Style MT Std Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Futura-Book Book.ttf" as="font" type="font/ttf" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Italian Old Style MT';
        src: url('/fonts/Italian Old Style MT Std Regular.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Futura Book';
        src: url('/fonts/Futura-Book Book.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
    </style>
    <meta name="generator" content={Astro.generator} />
    <title>{displayTitle}</title>
    {baseJsonLd && <JsonLd nodes={[baseJsonLd]} />}
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = stored === 'dark' || (!stored && prefersDark);
        if (dark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-[#0a0a0a] dark:text-gray-100">
    <header class="sticky top-0 z-50 border-b border-primary/20 bg-white sm:shadow-sm md:shadow-md dark:bg-[#0a0a0a]">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between md:h-24">
          <a href="/" class="flex items-center gap-2" aria-label="PHC Home">
            <img src="/images/logo-light.png" alt="PH&C" class="h-10 w-auto md:h-[55px] dark:hidden" width="1462" height="324" />
            <img src="/images/logo-dark.png" alt="PH&C" class="h-10 w-auto md:h-[55px] hidden dark:block" width="1462" height="324" />
          </a>
          <nav class="flex items-center gap-2 md:gap-6" aria-label="Main">

            <div class="hidden md:flex md:items-center md:gap-6" data-desktop-nav>
              <a href="/" class="font-heading text-base font-semibold text-primary hover:text-primary/80">Home</a>
              <a href="/about" class="font-heading text-base font-semibold text-primary hover:text-primary/80">About</a>
              <a href="/services" class="font-heading text-base font-semibold text-primary hover:text-primary/80">Services</a>
              <a href="/portfolio" class="font-heading text-base font-semibold text-primary hover:text-primary/80">Portfolio</a>
              <a href="/contact" class="font-heading text-base font-semibold text-primary hover:text-primary/80">Contact</a>
            </div>            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg p-2 text-primary hover:bg-primary/10 focus:outline-none focus:ring-2 focus:ring-primary/50"
              aria-label="Toggle dark mode"
              data-theme-toggle
            >
              <span class="dark:hidden" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
              </span>
              <span class="hidden dark:inline" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              </span>
            </button>
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg p-2 text-primary hover:bg-primary/10 md:hidden"
              aria-label="Toggle menu"
              aria-expanded="false"
              data-mobile-menu-toggle
            >
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </nav>
        </div>
        <div class="hidden border-t border-primary/20 py-2 md:hidden" data-mobile-menu aria-hidden="true">
          <a href="/" class="block px-4 py-2 font-heading text-base font-semibold text-primary hover:bg-primary/10 dark:hover:bg-primary/20">Home</a>
          <a href="/about" class="block px-4 py-2 font-heading text-base font-semibold text-primary hover:bg-primary/10 dark:hover:bg-primary/20">About</a>
          <a href="/services" class="block px-4 py-2 font-heading text-base font-semibold text-primary hover:bg-primary/10 dark:hover:bg-primary/20">Services</a>
          <a href="/portfolio" class="block px-4 py-2 font-heading text-base font-semibold text-primary hover:bg-primary/10 dark:hover:bg-primary/20">Portfolio</a>
          <a href="/contact" class="block px-4 py-2 font-heading text-base font-semibold text-primary hover:bg-primary/10 dark:hover:bg-primary/20">Contact</a>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4 pt-0 pb-8 sm:px-6 lg:px-8">
        <slot />
      </div>
    </main>
    <Footer />
    <script>
      document.querySelector('[data-mobile-menu-toggle]')?.addEventListener('click', () => {
        const menu = document.querySelector('[data-mobile-menu]');
        const btn = document.querySelector('[data-mobile-menu-toggle]');
        if (!menu || !btn) return;
        const open = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!open));
      });

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
