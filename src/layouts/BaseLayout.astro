---
import JsonLd from "@/components/seo/JsonLd.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import {
  createGraphSchema,
  createOrganizationSchema,
  createWebPageSchema,
  createWebSiteSchema,
  toAbsoluteUrl,
  toCanonicalUrl,
  type BreadcrumbItem,
} from "@/lib/seo/jsonld";
import { BRAND_LOGO_URL, getImageSrcSet, getImageUrl } from "@/lib/cloudinary";
import { metaDescription } from "@/lib/seo/metaDescription";
import { HERO_SIZES } from "@/lib/hero-image";
import { getEntry } from "astro:content";

const DEFAULT_HEADER_LINKS = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Contact', href: '/contact' },
];

const siteSettings = await getEntry('site', 'index');
const headerLinks = siteSettings?.data?.headerLinks?.length
  ? siteSettings.data.headerLinks
  : DEFAULT_HEADER_LINKS;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLdNodes?: Record<string, unknown>[];
  breadcrumbs?: BreadcrumbItem[];
  /** Hide the visible breadcrumb below `lg`, where the section picker shows the same path. */
  breadcrumbsDesktopOnly?: boolean;
  ogType?: string;
  datePublished?: string;
  dateModified?: string;
  robots?: string;
  /** AVIF srcset for the LCP hero, matching `resolveHeroImage()`. */
  heroPreloadSrcSet?: string;
}

const {
  title = "PH&C",
  description,
  image,
  jsonLdNodes = [],
  breadcrumbs,
  breadcrumbsDesktopOnly = false,
  ogType = 'website',
  datePublished,
  dateModified,
  robots,
  heroPreloadSrcSet,
} = Astro.props as Props;
import '../styles/global.css';

const displayTitle = title.startsWith('PH&C - ') || title.startsWith('PH&C – ') ? title : `PH&C - ${title}`;
const metaDescriptionText = metaDescription(description, displayTitle);
const site = Astro.url.origin || import.meta.env.SITE || 'https://www.phandc.net';
const canonicalUrl = toCanonicalUrl(Astro.url.pathname, site);
const ogImageSource = image
  ? getImageUrl(image, { width: 1200, height: 630, crop: 'fill', quality: 'auto:eco' })
  : getImageUrl(BRAND_LOGO_URL, { width: 1200 });
const logoSrc = getImageUrl(BRAND_LOGO_URL, { width: 512 });
const logoSrcSet = getImageSrcSet(BRAND_LOGO_URL, [372, 512]);
const absoluteImageUrl = toAbsoluteUrl(ogImageSource, site);
const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
const gaMeasurementId = /^G-[A-Z0-9]+$/.test(googleAnalyticsId ?? '') ? googleAnalyticsId : '';
const baseJsonLd = createGraphSchema([
  createOrganizationSchema(site),
  createWebSiteSchema(site),
  createWebPageSchema({
    site,
    url: canonicalUrl,
    name: displayTitle,
    description: metaDescriptionText,
    image: absoluteImageUrl,
    datePublished,
    dateModified,
  }),
  ...jsonLdNodes,
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {heroPreloadSrcSet && (
      <>
        <link rel="preconnect" href="https://res.cloudinary.com" />
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset={heroPreloadSrcSet}
          imagesizes={HERO_SIZES}
          fetchpriority="high"
        />
      </>
    )}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={metaDescriptionText} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="PH&C" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta property="og:description" content={metaDescriptionText} />
    {ogType === 'article' && datePublished && (
      <meta property="article:published_time" content={datePublished} />
    )}
    {ogType === 'article' && dateModified && (
      <meta property="article:modified_time" content={dateModified} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={metaDescriptionText} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <link rel="preload" href="/fonts/Italian Old Style MT Std Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Futura-Book Book.ttf" as="font" type="font/ttf" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Italian Old Style MT';
        src: url('/fonts/Italian Old Style MT Std Regular.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Futura Book';
        src: url('/fonts/Futura-Book Book.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
    </style>
    <meta name="generator" content={Astro.generator} />
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
    <title>{displayTitle}</title>
    {baseJsonLd && <JsonLd nodes={[baseJsonLd]} />}
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = stored === 'dark' || (!stored && prefersDark);
        if (dark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-[#0a0a0a] dark:text-gray-100">
    <header class="sticky top-0 z-50 border-b border-primary/20 bg-white sm:shadow-sm md:shadow-md dark:bg-[#0a0a0a]">
      <div class="mx-auto max-w-8xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between md:h-24">
          <a href="/" class="flex items-center gap-2" aria-label="PHC Home">
            <img
              src={logoSrc}
              srcset={logoSrcSet}
              sizes="(min-width: 768px) 256px, 186px"
              alt="PH&C"
              class="h-10 w-auto md:h-[55px]"
              width="512"
              height="110"
            />
          </a>
          <nav class="flex items-center gap-2 md:gap-6" aria-label="Main">

            <div class="hidden md:flex md:items-center md:gap-6" data-desktop-nav>
              {headerLinks.map((link) => (
                <a
                  href={link.href}
                  target={link.newTab ? '_blank' : undefined}
                  rel={link.newTab ? 'noopener noreferrer' : undefined}
                  class="font-heading text-base font-semibold text-primary hover:text-primary/80"
                >
                  {link.label}
                </a>
              ))}
            </div>            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg p-2 text-primary hover:bg-primary/10 focus:outline-none focus:ring-2 focus:ring-primary/50"
              aria-label="Toggle dark mode"
              data-theme-toggle
            >
              <span class="dark:hidden" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
              </span>
              <span class="hidden dark:inline" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              </span>
            </button>
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg p-2 text-primary hover:bg-primary/10 md:hidden"
              aria-label="Toggle menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
              data-mobile-menu-toggle
            >
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </nav>
        </div>
      </div>
      <div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true" inert>
        <div class="mobile-menu-clip">
          <div class="mobile-menu-surface">
            <nav class="mx-auto max-w-8xl px-4 py-2 sm:px-6 lg:px-8" aria-label="Mobile">
              {headerLinks.map((link) => (
                <a
                  href={link.href}
                  target={link.newTab ? '_blank' : undefined}
                  rel={link.newTab ? 'noopener noreferrer' : undefined}
                  class="block px-4 py-2 font-heading text-base font-semibold text-primary hover:bg-primary/10 dark:hover:bg-primary/20"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-8xl px-4 pt-0 pb-8 sm:px-6 lg:px-8">
        <slot name="hero" />
        <Breadcrumbs items={breadcrumbs} desktopOnly={breadcrumbsDesktopOnly} />
        <slot />
      </div>
    </main>
    <Footer />
    <script>
      document.querySelector('[data-mobile-menu-toggle]')?.addEventListener('click', () => {
        const menu = document.querySelector('[data-mobile-menu]');
        const btn = document.querySelector('[data-mobile-menu-toggle]');
        if (!menu || !btn) return;
        const open = menu.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-hidden', String(!open));
        menu.toggleAttribute('inert', !open);
      });

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
