---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message Sent"
  description="Thank you for contacting PH&C. We'll be in touch soon."
>
  <section class="mx-auto max-w-2xl py-20 text-center">
    <p class="text-sm font-medium uppercase tracking-wider text-primary">Contact</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Thank you for reaching out</h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      Your message has been sent. Someone from our team will get back to you as soon as possible.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/contact" class="btn btn-secondary">Return to contact</a>
    </div>
  </section>
</BaseLayout>
