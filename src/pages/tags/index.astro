---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getImageUrl, getImageSrcSet } from '@/lib/cloudinary';
import { getPortfolioTagSlugs } from '@/lib/tags';
import { createBreadcrumbListSchema } from '@/lib/seo/jsonld';

const CARD_WIDTHS = [320, 480, 640, 960, 1280];
const CARD_SIZES = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw';

const tags = await getCollection('tags');
const portfolio = await getCollection('portfolio');

const counts = new Map<string, number>();
for (const entry of portfolio) {
  for (const slug of getPortfolioTagSlugs(entry)) {
    counts.set(slug, (counts.get(slug) ?? 0) + 1);
  }
}

const sortedTags = tags
  .map((entry) => ({ entry, count: counts.get(entry.id) ?? 0 }))
  .sort((a, b) => {
    const orderA = a.entry.data.order ?? 999;
    const orderB = b.entry.data.order ?? 999;
    if (orderA !== orderB) return orderA - orderB;
    return (a.entry.data.label ?? '').localeCompare(b.entry.data.label ?? '');
  });

const siteEntry = await getEntry('site', 'index');
const tagsTitle = siteEntry?.data?.tagsTitle ?? 'Tags';
const site = Astro.url.origin || import.meta.env.SITE || 'https://phandc.net';
const jsonLdNodes = [
  createBreadcrumbListSchema(site, [
    { name: 'Home', path: '/' },
    { name: 'Tags', path: '/tags' },
  ]),
];
---

<BaseLayout title={tagsTitle} jsonLdNodes={jsonLdNodes}>
  <div class="pt-8 space-y-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Tags</h1>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        Browse our work by tag.
      </p>
    </div>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sortedTags.map(({ entry, count }) => {
        const imageUrl = entry.data.image
          ? getImageUrl(entry.data.image, { width: 960, quality: 'auto:eco' })
          : undefined;
        const imageSrcSet = entry.data.image
          ? getImageSrcSet(entry.data.image, CARD_WIDTHS, { quality: 'auto:eco' })
          : undefined;
        return (
          <li>
            <a
              href={`/tags/${entry.id}`}
              class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white text-gray-900 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-lg dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100"
            >
              {imageUrl && (
                <div class="relative aspect-[16/9] w-full shrink-0 overflow-hidden bg-gray-100 dark:bg-gray-700">
                  <img
                    src={imageUrl}
                    srcset={imageSrcSet}
                    sizes={CARD_SIZES}
                    alt={entry.data.label}
                    loading="lazy"
                    width="960"
                    height="540"
                    class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <div class="flex min-h-0 flex-1 flex-col gap-2 p-5">
                <div class="flex items-start justify-between gap-3">
                  <h2 class="text-base font-semibold tracking-tight text-gray-900 dark:text-gray-100">
                    {entry.data.label}
                  </h2>
                  <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                    {count}
                  </span>
                </div>
                {entry.data.description && (
                  <p class="text-sm text-gray-600 line-clamp-3 dark:text-gray-400">
                    {entry.data.description}
                  </p>
                )}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>
