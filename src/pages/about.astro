---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '@/lib/islands';
import PersonnelCard from '../components/PersonnelCard.astro';
import VideoGrid from '../components/VideoGrid.astro';
import ContentCards from '../components/ContentCards.astro';
import { toVideoViews } from '@/lib/videos';
import { withStaffSlugs } from '@/data/staff';
import { isPublished, publishedOnly } from '@/lib/published';
import { createBreadcrumbListSchema } from '@/lib/seo/jsonld';
import { getImageSrcSet, getImageUrl } from '@/lib/cloudinary';

const entry = await getEntry('about', 'index');
if (!entry) {
  throw new Error('About content not found. Run: npm run generate:about');
}
// The dev server still renders About so Tina can edit it while it is off the
// public site. The production build responds 404, and the build hook removes
// about.html so the deployed URL is gone.
if (!isPublished(entry.data) && !import.meta.env.DEV) {
  return new Response('Not Found', { status: 404, statusText: 'Not Found' });
}
const { Content } = await render(entry);

const staffEntry = await getEntry('staff', 'index');
const people = publishedOnly(withStaffSlugs(staffEntry?.data?.staff ?? []));

const videos = toVideoViews(entry.data.videos, 'about');

const ogImage = entry.data.featuredImage;
const aboutImage = ogImage?.trim();
const aboutImageSrc = aboutImage ? getImageUrl(aboutImage, { width: 1600 }) : undefined;
const aboutImageSrcSet = aboutImage ? getImageSrcSet(aboutImage, [640, 960, 1280, 1600, 1920]) : undefined;
const ogDescription = entry.data.description ?? 'Our team, our values, and our commitment to delivering quality construction and development services.';
const site = Astro.url.origin || import.meta.env.SITE || "https://www.phandc.net";
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "About", path: "/about" },
];
const jsonLdNodes = [
  createBreadcrumbListSchema(site, breadcrumbs),
];
---

<BaseLayout title={entry.data.title} description={ogDescription} image={ogImage} jsonLdNodes={jsonLdNodes} breadcrumbs={breadcrumbs}>
  <article class="pt-8 space-y-8">
    <TinaIsland name="about" wrapper={islands.about.wrapper} primary>
      <section class="space-y-4">
        {aboutImageSrc && (
          <img
            src={aboutImageSrc}
            srcset={aboutImageSrcSet}
            sizes="(min-width: 90rem) 86rem, 100vw"
            alt={entry.data.title}
            width="1600"
            height="686"
            class="aspect-[21/9] w-full rounded-lg object-cover"
          />
        )}
        <div class="space-y-2">
          <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">{entry.data.title}</h1>
          {entry.data.description && (
            <p class="max-w-3xl text-lg text-gray-600 dark:text-gray-400">{entry.data.description}</p>
          )}
        </div>
      </section>
      <section class="prose-content prose-img:rounded-lg">
        <Content />
      </section>
    </TinaIsland>

    <TinaIsland name="aboutCards" wrapper={islands.aboutCards.wrapper}>
      <ContentCards cards={entry.data.contentCards} sectionId="about-card" />
    </TinaIsland>

    {people.length > 0 && (
      <TinaIsland name="staff" wrapper={islands.staff.wrapper}>
        <section class="pt-4">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Key Personnel</h2>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {people.map((member) => (
              <li>
                <PersonnelCard
                  name={member.name}
                  title={member.title}
                  image={member.image}
                  href={`/about/${member.slug}`}
                />
              </li>
            ))}
          </ul>
        </section>
      </TinaIsland>
    )}

    {videos.length > 0 && (
      <section class="pt-4 space-y-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Videos</h2>
        <VideoGrid videos={videos} sectionId="about" />
      </section>
    )}
  </article>
</BaseLayout>
