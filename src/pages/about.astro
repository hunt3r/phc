---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '@/lib/islands';
import PersonnelCard from '../components/PersonnelCard.astro';
import VideoGrid from '../components/VideoGrid.astro';
import ContentCards from '../components/ContentCards.astro';
import { toVideoViews } from '@/lib/videos';
import { createBreadcrumbListSchema, createPersonSchema } from '@/lib/seo/jsonld';

const entry = await getEntry('about', 'index');
if (!entry) {
  throw new Error('About content not found. Run: npm run generate:about');
}
const { Content } = await render(entry);

const staffEntry = await getEntry('staff', 'index');
const staff = staffEntry?.data?.staff ?? [];

const videos = toVideoViews(entry.data.videos, 'about');

const ogImage = entry.data.featuredImage;
const ogDescription = entry.data.description ?? 'Our team, our values, and our commitment to delivering quality construction and development services.';
const site = Astro.url.origin || import.meta.env.SITE || "https://phandc.net";
const jsonLdNodes = [
  createBreadcrumbListSchema(site, [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
  ...staff.map((member) =>
    createPersonSchema(site, {
      name: member.name,
      jobTitle: member.title,
      bio: member.bio,
      image: member.image,
    })
  ),
];
---

<BaseLayout title={entry.data.title} description={ogDescription} image={ogImage} jsonLdNodes={jsonLdNodes}>
  <article class="pt-8 space-y-8">
    <TinaIsland name="about" wrapper={islands.about.wrapper} primary>
      <section class="space-y-4">
        {entry.data.featuredImage && (
          <img
            src={entry.data.featuredImage}
            alt={entry.data.title}
            class="aspect-[21/9] w-full rounded-lg object-cover"
          />
        )}
        <div class="space-y-2">
          <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">{entry.data.title}</h1>
          {entry.data.description && (
            <p class="max-w-3xl text-lg text-gray-600 dark:text-gray-400">{entry.data.description}</p>
          )}
        </div>
      </section>
      <section class="prose-content prose-img:rounded-lg">
        <Content />
      </section>
    </TinaIsland>

    <TinaIsland name="aboutCards" wrapper={islands.aboutCards.wrapper}>
      <ContentCards cards={entry.data.contentCards} sectionId="about-card" />
    </TinaIsland>

    <TinaIsland name="staff" wrapper={islands.staff.wrapper}>
      <section class="pt-4">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Key Personnel</h2>
        <div class="grid grid-cols-1 gap-6">
          {staff.map((member) => (
            <PersonnelCard
              name={member.name}
              title={member.title}
              bio={member.bio}
              image={member.image}
              note={member.note}
            />
          ))}
        </div>
      </section>
    </TinaIsland>

    {videos.length > 0 && (
      <section class="pt-4 space-y-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Videos</h2>
        <VideoGrid videos={videos} sectionId="about" />
      </section>
    )}
  </article>
</BaseLayout>
