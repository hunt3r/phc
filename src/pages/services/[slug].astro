---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import ServicesNav from '../../components/ServicesNav.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import { getImageUrl } from '@/lib/cloudinary';
import {
  getTagMap,
  portfolioEntriesForTagTree,
  tagsWithRoot,
} from '@/lib/tags';
import { toVideoViews } from '@/lib/videos';
import { createBreadcrumbListSchema } from '@/lib/seo/jsonld';

export async function getStaticPaths() {
  const tags = await getCollection('tags');
  const tagMap = new Map(tags.map((t) => [t.id, t]));
  return tagsWithRoot('services', tagMap).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const serviceLabel = entry.data.label;

const portfolio = await getCollection('portfolio');
const tagMap = await getTagMap();
const entries = portfolioEntriesForTagTree(entry.id, portfolio, tagMap).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

const videos = toVideoViews(entry.data.videos, `service-${entry.id}`);

const HERO_WIDTHS = [640, 960, 1280, 1600, 1920, 2560];
const heroImageUrl = entry.data.image
  ? getImageUrl(entry.data.image, { width: 1920, quality: 'auto:eco' })
  : undefined;
const heroImageSrcSet = entry.data.image
  ? HERO_WIDTHS.map((width) => `${getImageUrl(entry.data.image, { width, quality: 'auto:eco' })} ${width}w`).join(', ')
  : undefined;

const ogDescription = entry.data.description
  ? entry.data.description.slice(0, 160).trim()
  : undefined;
const site = Astro.url.origin || import.meta.env.SITE || 'https://phandc.net';
const jsonLdNodes = [
  createBreadcrumbListSchema(site, [
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: serviceLabel, path: `/services/${entry.id}` },
  ]),
];
---

<BaseLayout title={serviceLabel} description={ogDescription} image={entry.data.image} jsonLdNodes={jsonLdNodes}>
  {heroImageUrl && (
    <img
      src={heroImageUrl}
      srcset={heroImageSrcSet}
      sizes="100vw"
      alt={serviceLabel}
      width="1920"
      height="823"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="relative left-1/2 w-screen max-w-none -translate-x-1/2 aspect-[21/9] object-cover"
    />
  )}

  <div class="pt-8 flex flex-col gap-8 lg:flex-row lg:gap-12">
    <ServicesNav activeId={entry.id} />

    <div class="min-w-0 flex-1 space-y-8">
      <nav class="text-sm text-gray-500 dark:text-gray-400" aria-label="Breadcrumb">
        <a href="/services" class="transition hover:text-primary">Services</a>
        <span class="px-1.5">/</span>
        <span class="text-gray-700 dark:text-gray-300">{serviceLabel}</span>
      </nav>

      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">{serviceLabel}</h1>
        {entry.data.description && (
          <p class="mt-2 max-w-3xl text-lg text-gray-600 dark:text-gray-400">{entry.data.description}</p>
        )}
      </div>

      <section class="prose-content">
        <Content />
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Projects</h2>
          <p class="shrink-0 text-sm text-gray-600 dark:text-gray-400">
            {entries.length} project{entries.length === 1 ? '' : 's'}
          </p>
        </div>

        {entries.length > 0 ? (
          <ul class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
            {entries.map((portfolioEntry) => (
              <li>
                <ProjectCard
                  title={portfolioEntry.data.title ?? ''}
                  description={portfolioEntry.data.description ?? ''}
                  href={`/portfolio/${portfolioEntry.id}`}
                  imageSrc={portfolioEntry.data.image}
                  imageAlt={portfolioEntry.data.title ?? ''}
                  date={portfolioEntry.data.date}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-600 dark:text-gray-400">No projects for this service yet.</p>
        )}
      </section>

      {videos.length > 0 && (
        <section class="space-y-6">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Videos</h2>
          <VideoGrid videos={videos} sectionId={`service-${entry.id}`} />
        </section>
      )}
    </div>
  </div>
</BaseLayout>
