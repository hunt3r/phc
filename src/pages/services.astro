---
import ContentPageSection from '../components/ContentPageSection.astro';
import { getImageUrl, getImageSrcSet } from '@/lib/cloudinary';
import { getTagMap, childrenOf, tagHref } from '@/lib/tags';
import {
  CORE_SERVICES,
  createServiceSchema,
  createFaqSchema,
} from '@/lib/seo/jsonld';

const site = Astro.url.origin || import.meta.env.SITE || 'https://phandc.net';

const tagMap = await getTagMap();
const serviceTags = childrenOf('services', tagMap);

const CARD_WIDTHS = [320, 480, 640, 960, 1280];
const CARD_SIZES = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw';

const faqSchema = createFaqSchema([
  {
    question: 'What does PH&C do?',
    answer:
      "PH&C, LLC is an owner's-representation, construction management, and real estate development consulting firm based in Wayne, PA. We help owners and developers plan, design, procure, and build commercial, retail, healthcare, residential, self-storage, and institutional projects.",
  },
  {
    question: 'What is an owner\'s representative?',
    answer:
      "An owner's representative acts as the owner's agent and point of control across a project, functioning like your in-house real estate construction department - overseeing design, entitlement, procurement, and construction - without the overhead of hiring in-house staff.",
  },
  {
    question: 'What regions does PH&C serve?',
    answer:
      'PH&C is based in the Greater Philadelphia area and serves projects across Pennsylvania, New Jersey, Delaware, Maryland, and New York.',
  },
  {
    question: 'What types of projects does PH&C manage?',
    answer:
      'PH&C manages retail, office and warehouse, residential and multi-family, self-storage, healthcare, and government projects, including ground-up development, renovations, fit-outs, and re-development.',
  },
  {
    question: 'When was PH&C founded?',
    answer:
      'PH&C was founded in 2010 by Paul Harris and has since delivered a wide range of development and re-development projects for land owners, developers, businesses, and government agencies.',
  },
]);

const jsonLdNodes = [
  ...CORE_SERVICES.map((service) => createServiceSchema(site, service)),
  ...(faqSchema ? [faqSchema] : []),
];
---

<ContentPageSection
  entryId="services"
  path="/services"
  breadcrumbLabel="Services"
  jsonLdNodes={jsonLdNodes}
>
  {serviceTags.length > 0 && (
    <section class="mt-12 space-y-6">
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Explore our services</h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {serviceTags.map((tag) => {
          const imageUrl = tag.data.image
            ? getImageUrl(tag.data.image, { width: 960, quality: 'auto:eco' })
            : undefined;
          const imageSrcSet = tag.data.image
            ? getImageSrcSet(tag.data.image, CARD_WIDTHS, { quality: 'auto:eco' })
            : undefined;
          return (
            <li>
              <a
                href={tagHref(tag.id, tagMap)}
                class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white text-gray-900 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-lg dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100"
              >
                {imageUrl && (
                  <div class="relative aspect-[16/9] w-full shrink-0 overflow-hidden bg-gray-100 dark:bg-gray-700">
                    <img
                      src={imageUrl}
                      srcset={imageSrcSet}
                      sizes={CARD_SIZES}
                      alt={tag.data.label}
                      loading="lazy"
                      width="960"
                      height="540"
                      class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class="flex min-h-0 flex-1 flex-col gap-2 p-5">
                  <h3 class="text-base font-semibold tracking-tight text-gray-900 dark:text-gray-100">
                    {tag.data.label}
                  </h3>
                  {tag.data.description && (
                    <p class="text-sm text-gray-600 line-clamp-3 dark:text-gray-400">
                      {tag.data.description}
                    </p>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</ContentPageSection>
