---
import BaseLayout from '../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '@/lib/islands';
import HeroPage from '../components/blocks/hero-page.astro';
import ContentCards from '../components/ContentCards.astro';
import ServiceGroup from '../components/ServiceGroup.astro';
import { render } from 'astro:content';
import { getImageUrl, getImageSrcSet } from '@/lib/cloudinary';
import { getTagMap, childrenOf, tagHref } from '@/lib/tags';
import {
  CORE_SERVICES,
  createServiceSchema,
  createFaqSchema,
  createBreadcrumbListSchema,
} from '@/lib/seo/jsonld';

const site = Astro.url.origin || import.meta.env.SITE || 'https://www.phandc.net';

const tagMap = await getTagMap();
const servicesRoot = tagMap.get('services');

// The curated 1st-level services carry an `order`; legacy portfolio-tag stubs
// under `services` (landscaping, remediation, etc.) do not and are excluded here.
const serviceTags = childrenOf('services', tagMap).filter((t) => t.data.order != null);

const sections = await Promise.all(
  serviceTags.map(async (tag) => ({
    id: tag.id,
    label: tag.data.label,
    href: tagHref(tag.id, tagMap),
    description: tag.data.description?.trim() || undefined,
    Content: (await render(tag)).Content,
    image: tag.data.image
      ? {
          src: getImageUrl(tag.data.image, { width: 800, quality: 'auto:eco' }),
          srcset: getImageSrcSet(tag.data.image, [480, 640, 800, 1200], { quality: 'auto:eco' }),
        }
      : undefined,
    children: childrenOf(tag.id, tagMap).map((child) => ({
      label: child.data.label,
      href: tagHref(child.id, tagMap),
      children: childrenOf(child.id, tagMap).map((grandchild) => ({
        label: grandchild.data.label,
        href: tagHref(grandchild.id, tagMap),
      })),
    })),
  }))
);

// Two childless groups in a row share a row on wide screens. A lone childless
// group stays full width, as does every group that has services under it.
const rows: Array<
  | { kind: 'pair'; sections: typeof sections }
  | { kind: 'full'; section: (typeof sections)[number]; imageOnEnd: boolean }
> = [];
let fullWidthIndex = 0;
for (let i = 0; i < sections.length; i++) {
  const current = sections[i];
  const next = sections[i + 1];
  if (current.children.length === 0 && next && next.children.length === 0) {
    rows.push({ kind: 'pair', sections: [current, next] });
    i += 1;
    continue;
  }
  rows.push({
    kind: 'full',
    section: current,
    imageOnEnd: fullWidthIndex % 2 === 0,
  });
  fullWidthIndex += 1;
}

const faqSchema = createFaqSchema([
  {
    question: 'What does PH&C do?',
    answer:
      "PH&C, LLC is an owner's-representation, construction management, and real estate development consulting firm based in Wayne, PA. We help owners and developers plan, design, procure, and build commercial, retail, healthcare, residential, self-storage, and institutional projects.",
  },
  {
    question: 'What is an owner\'s representative?',
    answer:
      "An owner's representative acts as the owner's agent and point of control across a project, functioning like your in-house real estate construction department - overseeing design, entitlement, procurement, and construction - without the overhead of hiring in-house staff.",
  },
  {
    question: 'What regions does PH&C serve?',
    answer:
      'PH&C is based in the Greater Philadelphia area and serves projects across Pennsylvania, New Jersey, Delaware, Maryland, and New York.',
  },
  {
    question: 'What types of projects does PH&C manage?',
    answer:
      'PH&C manages retail, office and warehouse, residential and multi-family, self-storage, healthcare, and government projects, including ground-up development, renovations, fit-outs, and re-development.',
  },
  {
    question: 'When was PH&C founded?',
    answer:
      'PH&C was founded in 2010 by Paul Harris and has since delivered a wide range of development and re-development projects for land owners, developers, businesses, and government agencies.',
  },
]);

const description =
  servicesRoot?.data.description ??
  'The owner\'s-representation, construction management, and development services PH&C provides.';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: servicesRoot?.data.label ?? 'Services', path: '/services' },
];
const jsonLdNodes = [
  createBreadcrumbListSchema(site, breadcrumbs),
  ...CORE_SERVICES.map((service) => createServiceSchema(site, service)),
  ...(faqSchema ? [faqSchema] : []),
];
---

<BaseLayout
  title="Services"
  description={description}
  image={servicesRoot?.data.image}
  jsonLdNodes={jsonLdNodes}
  breadcrumbs={breadcrumbs}
  ogType="article"
>
  <TinaIsland slot="hero" name="tagHero" wrapper={islands.tagHero.wrapper} params={{ slug: 'services' }} primary>
    <HeroPage
      id="services-hero"
      size="compact"
      tagline={servicesRoot?.data.label ?? 'Services'}
      subtitle={description}
      backgroundImage={servicesRoot?.data.image}
      overlayOpacity={70}
      overlayColor="dark"
    />
  </TinaIsland>

  <TinaIsland name="tagCards" wrapper={islands.tagCards.wrapper} params={{ slug: 'services' }}>
    <ContentCards cards={servicesRoot?.data.contentCards} sectionId="services-card" allowFullBleed={false} />
  </TinaIsland>

  <div class="space-y-12 pt-10">
    {
      rows.map((row) =>
        row.kind === 'pair' ? (
          <div class="grid gap-6 lg:grid-cols-2">
            {row.sections.map((section) => (
              <ServiceGroup
                id={section.id}
                label={section.label}
                href={section.href}
                image={section.image}
                description={section.description}
                body={section.Content}
                layout="card"
                children={section.children}
              />
            ))}
          </div>
        ) : (
          <ServiceGroup
            id={row.section.id}
            label={row.section.label}
            href={row.section.href}
            image={row.section.image}
            imageOnEnd={row.imageOnEnd}
            description={row.section.description}
            body={row.section.Content}
            layout="banner"
            children={row.section.children}
          />
        )
      )
    }
  </div>
</BaseLayout>
