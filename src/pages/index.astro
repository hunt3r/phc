---
import BaseLayout from '../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '@/lib/islands';
import HeroCarousel from '../components/blocks/hero-carousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import VideoGrid from '../components/VideoGrid.astro';
import QuoteCard from '../components/QuoteCard.astro';
import ContentCards from '../components/ContentCards.astro';
import { getFeaturedQuotes } from '@/lib/quotes';
import { getFeaturedVideos } from '@/lib/videos';
import { getTagMap, tagHref } from '@/lib/tags';
import { getEntry, getCollection } from 'astro:content';
import type { HeroSlide } from '../components/blocks/hero-carousel.astro';

const homeEntry = await getEntry('home', 'index');
const data = homeEntry?.data;
const hero = data?.hero;
const portfolioEntries = await getCollection('portfolio');

const byOrderThenTitle = (a: any, b: any) => {
  const orderA = (a.data as any).order ?? 999;
  const orderB = (b.data as any).order ?? 999;
  if (orderA !== orderB) return orderA - orderB;
  return ((a.data as any).title ?? '').localeCompare((b.data as any).title ?? '');
};

const maxProjects = data?.maxProjects ?? 3;
const maxTestimonials = data?.maxTestimonials ?? 8;
const maxVideos = data?.maxVideos ?? 8;
const maxHeroSlides = hero?.maxHeroSlides ?? 5;
const showFeaturedProjects = hero?.showFeaturedProjects !== false;
const showFeaturedTags = hero?.showFeaturedTags !== false;

const latestProjects = [...portfolioEntries].sort(byOrderThenTitle).slice(0, maxProjects);

const featuredQuotes = (await getFeaturedQuotes()).slice(0, maxTestimonials);
const featuredVideos = (await getFeaturedVideos()).slice(0, maxVideos);

// Within a group, a set Hero order comes first. A blank one keeps list order
// for custom slides and falls back to title for projects and tags.
const heroRank = (order: number | undefined) => (order == null ? Number.POSITIVE_INFINITY : order);
const byHeroThenList = (
  a: { heroOrder?: number; title: string; listIndex: number },
  b: { heroOrder?: number; title: string; listIndex: number },
) => {
  const rankA = heroRank(a.heroOrder);
  const rankB = heroRank(b.heroOrder);
  if (rankA !== rankB) return rankA - rankB;
  if (a.listIndex !== b.listIndex) return a.listIndex - b.listIndex;
  return a.title.localeCompare(b.title);
};

const HERO_GROUPS = ['slides', 'tags', 'projects'] as const;
type HeroGroup = (typeof HERO_GROUPS)[number];
const isHeroGroup = (type: string | undefined): type is HeroGroup =>
  type === 'slides' || type === 'tags' || type === 'projects';
const savedGroups = (hero?.groupOrder ?? [])
  .map((item) => item.type)
  .filter(isHeroGroup)
  .filter((type, index, all) => all.indexOf(type) === index);
const orderedGroups: HeroGroup[] = [
  ...savedGroups,
  ...HERO_GROUPS.filter((type) => !savedGroups.includes(type)),
];

type HeroCandidate = HeroSlide & { heroOrder?: number; listIndex: number };

const projectSlides: HeroCandidate[] = showFeaturedProjects ? portfolioEntries
  .filter((entry) => entry.data.featured && entry.data.image)
  .map((entry) => ({
    design: 'slide',
    title: entry.data.title,
    description: entry.data.description ?? '',
    href: `/portfolio/${entry.id}`,
    ctaText: 'View project',
    image: entry.data.image,
    heroOrder: entry.data.heroOrder,
    listIndex: 0,
  })) : [];

const tagMap = await getTagMap();
const tagSlides: HeroCandidate[] = showFeaturedTags ? [...tagMap.values()]
  .filter((entry) => entry.data.featured && entry.data.image)
  .map((entry) => ({
    design: 'slide',
    title: entry.data.label,
    description: entry.data.description ?? '',
    href: tagHref(entry.id, tagMap),
    ctaText: `View ${entry.data.label}`,
    image: entry.data.image,
    heroOrder: entry.data.heroOrder,
    listIndex: 0,
  })) : [];

const customSlides: HeroCandidate[] = (hero?.slides ?? []).flatMap((slide, listIndex) => {
  const hasBannerFields = Boolean(slide.eyebrow?.trim() || slide.ctaSecondaryText?.trim() || slide.ctaSecondaryHref?.trim());
  const design = slide.design === 'banner' || slide.design === 'slide'
    ? slide.design
    : hasBannerFields
      ? 'banner'
      : 'slide';
  const image = typeof slide.image === 'string' ? slide.image.trim() : '';
  const title = slide.title?.trim() ?? '';
  const hasBannerContent = Boolean(title || slide.description?.trim() || slide.eyebrow?.trim() || image);
  if (design === 'slide' && !image) return [];
  if (design === 'banner' && !hasBannerContent) return [];
  return [{
    design,
    title,
    description: slide.description,
    eyebrow: slide.eyebrow,
    href: slide.ctaHref,
    ctaText: slide.ctaText,
    ctaSecondaryText: slide.ctaSecondaryText,
    ctaSecondaryHref: slide.ctaSecondaryHref,
    image: image || undefined,
    heroOrder: slide.heroOrder,
    listIndex,
  }];
});

const slidesByGroup: Record<HeroGroup, HeroCandidate[]> = {
  slides: customSlides.sort(byHeroThenList),
  tags: tagSlides.sort(byHeroThenList),
  projects: projectSlides.sort(byHeroThenList),
};
const promotedSlides = orderedGroups
  .flatMap((group) => slidesByGroup[group])
  .slice(0, Math.max(0, maxHeroSlides));

const ogDescription = data?.description ?? "PH&C facilitates Real Estate Development as the tri-state area's premiere Owner's Representation, Construction Management, and Fee Development firm.";
const ogImage = promotedSlides[0]?.image;
---

<BaseLayout title={data?.title ?? 'Home'} description={ogDescription} image={ogImage}>
  <TinaIsland name="home" wrapper={islands.home.wrapper} primary>
  {promotedSlides.length > 0 && (
    <HeroCarousel
      size={hero?.size ?? 'full'}
      slides={promotedSlides}
      overlayOpacity={hero?.overlayOpacity ?? 85}
      overlayColor={hero?.overlayColor ?? 'dark'}
    />
  )}
  </TinaIsland>
  <article class:list={['space-y-16', { 'pt-16 sm:pt-20': !data?.contentCards?.length }]}>

    <TinaIsland name="homeCards" wrapper={islands.homeCards.wrapper}>
      <ContentCards cards={data?.contentCards} sectionId="home-card" />
    </TinaIsland>

    {latestProjects.length > 0 && (
      <section>
        <div class="mb-8 text-center">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 sm:text-3xl">
            Latest projects
          </h2>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Recent construction and renovation work from the PH&amp;C team.
          </p>
        </div>
        <div class="grid w-full gap-6 grid-cols-1 sm:grid-cols-[repeat(auto-fit,minmax(260px,1fr))]">
          {latestProjects.map((entry) => (
            <ProjectCard
              title={(entry.data as any).title}
              description={(entry.data as any).description ?? ''}
              href={`/portfolio/${entry.id}`}
              imageSrc={(entry.data as any).image}
              imageAlt={(entry.data as any).title}
              date={(entry.data as any).date}
            />
          ))}
        </div>
      </section>
    )}

    {featuredVideos.length > 0 && (
      <section>
        <div class="mb-8 text-center">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 sm:text-3xl">
            Videos
          </h2>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            A closer look at our projects and team.
          </p>
        </div>
        <VideoGrid videos={featuredVideos} sectionId="home-featured" />
        <div class="mt-8 text-center">
          <a href="/videos" class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline">
            <span>View all videos</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}
    {featuredQuotes.length > 0 && (
      <section>
        <div class="mb-8 text-center">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 sm:text-3xl">
            What our clients say
          </h2>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Feedback from the owners and teams we partner with.
          </p>
        </div>
        <div class="grid w-full gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {featuredQuotes.map((q) => (
            <QuoteCard
              quote={q.quote}
              author={q.author}
              role={q.role}
              projectTitle={q.projectTitle}
              projectHref={q.projectHref}
            />
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/testimonials" class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline">
            <span>View all testimonials</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
