---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from '../components/blocks/hero-page.astro';
import HeroCarousel from '../components/blocks/hero-carousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import YouTubeEmbed from '../components/blocks/youtube-embed.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { getFeaturedQuotes } from '@/lib/quotes';
import { getEntry, getCollection } from 'astro:content';

const homeEntry = await getEntry('home', 'index');
const data = homeEntry?.data;
const hero = data?.hero;
const portfolioEntries = await getCollection('portfolio');

const byOrderThenTitle = (a: any, b: any) => {
  const orderA = (a.data as any).order ?? 999;
  const orderB = (b.data as any).order ?? 999;
  if (orderA !== orderB) return orderA - orderB;
  return ((a.data as any).title ?? '').localeCompare((b.data as any).title ?? '');
};

const latestProjects = [...portfolioEntries].sort(byOrderThenTitle).slice(0, 3);

const featuredQuotes = await getFeaturedQuotes();

// Promoted items: featured and with a hero/cover image. Items missing an
// image are soft-skipped so a stray `featured: true` never breaks the build.
const promotedSlides = [...portfolioEntries]
  .filter((e) => (e.data as any).featured && (e.data as any).image)
  .sort(byOrderThenTitle)
  .slice(0, 5)
  .map((entry) => ({
    title: (entry.data as any).title,
    description: (entry.data as any).description ?? '',
    href: `/portfolio/${entry.id}`,
    image: (entry.data as any).image as string,
  }));

const ogDescription = hero?.subtitle ?? (typeof data?.about?.body === 'string' ? data.about.body.slice(0, 160).trim() : undefined) ?? "PH&C facilitates Real Estate Development as the tri-state area's premiere Owner's Representation, Construction Management, and Fee Development firm.";
const ogImage = promotedSlides[0]?.image ?? (typeof hero?.backgroundImage === 'string' ? hero.backgroundImage : undefined);
---

<BaseLayout title={data?.title ?? 'Home'} description={ogDescription} image={ogImage}>
  {promotedSlides.length > 0 ? (
    <HeroCarousel
      size={hero?.size ?? 'full'}
      slides={promotedSlides}
      overlayOpacity={hero?.overlayOpacity ?? 85}
      overlayColor={hero?.overlayColor ?? 'dark'}
    />
  ) : (
    <HeroPage
      size={hero?.size ?? 'full'}
      eyebrow={hero?.eyebrow}
      tagline={hero?.tagline ?? 'Welcome to PHC'}
      subtitle={hero?.subtitle ?? 'Construction and renovation expertise.'}
      ctaPrimaryText={hero?.ctaPrimaryText}
      ctaPrimaryHref={hero?.ctaPrimaryHref}
      ctaSecondaryText={hero?.ctaSecondaryText}
      ctaSecondaryHref={hero?.ctaSecondaryHref}
      backgroundImage={typeof hero?.backgroundImage === 'string' ? hero.backgroundImage : undefined}
      overlayOpacity={hero?.overlayOpacity ?? 70}
      overlayColor={hero?.overlayColor ?? 'dark'}
    />
  )}
  <article class="pt-16 space-y-16 sm:pt-20">

    {latestProjects.length > 0 && (
      <section>
        <div class="mb-8 text-center">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 sm:text-3xl">
            Latest projects
          </h2>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Recent construction and renovation work from the PH&amp;C team.
          </p>
        </div>
        <div class="grid w-full gap-6 grid-cols-1 sm:grid-cols-[repeat(auto-fit,minmax(260px,1fr))]">
          {latestProjects.map((entry) => (
            <ProjectCard
              title={(entry.data as any).title}
              description={(entry.data as any).description ?? ''}
              href={`/portfolio/${entry.id}`}
              imageSrc={(entry.data as any).image}
              imageAlt={(entry.data as any).title}
              date={(entry.data as any).date}
            />
          ))}
        </div>
      </section>
    )}

    {featuredQuotes.length > 0 && (
      <section>
        <div class="mb-8 text-center">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 sm:text-3xl">
            What our clients say
          </h2>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Feedback from the owners and teams we partner with.
          </p>
        </div>
        <div class="grid w-full gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {featuredQuotes.map((q) => (
            <QuoteCard
              quote={q.quote}
              author={q.author}
              role={q.role}
              projectTitle={q.projectTitle}
              projectHref={q.projectHref}
            />
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/testimonials" class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline">
            <span>View all testimonials</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}

    {data?.about && (
      <section>
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          {data.about.heading ?? 'About Us'}
        </h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">
          {data.about.body ?? 'We deliver quality construction and renovation projects.'}
        </p>
      </section>
    )}

    {data?.contactCta && (
      <section class="rounded-xl border border-gray-200 bg-gray-50 p-8 text-center dark:border-gray-700 dark:bg-gray-800">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
          {data.contactCta.heading ?? 'Get in Touch'}
        </h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          {data.contactCta.subtext ?? 'Ready to start your project? Contact us today.'}
        </p>
      </section>
    )}

    <YouTubeEmbed url={data?.youtube} title={data?.title} />
  </article>
</BaseLayout>
