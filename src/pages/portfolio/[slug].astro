---
import { getCollection } from 'astro:content';
import { tagsWithRoot } from '@/lib/tags';
import PortfolioProjectPage from '../../components/PortfolioProjectPage.astro';
import PortfolioCategoryPage from '../../components/PortfolioCategoryPage.astro';

export async function getStaticPaths() {
  const portfolio = await getCollection('portfolio');
  const tags = await getCollection('tags');
  const tagMap = new Map(tags.map((t) => [t.id, t]));

  // Category (sector) landing pages share the /portfolio/<slug> namespace with
  // individual projects. Root ancestor `portfolio` -> rendered as a category.
  const categoryPaths = tagsWithRoot('portfolio', tagMap).map((entry) => ({
    params: { slug: entry.id },
    props: { kind: 'category' as const, entry },
  }));
  const projectPaths = portfolio.map((entry) => ({
    params: { slug: entry.id },
    props: { kind: 'project' as const, entry },
  }));

  return [...categoryPaths, ...projectPaths];
}

const { kind, entry } = Astro.props as
  | { kind: 'category'; entry: import('astro:content').CollectionEntry<'tags'> }
  | { kind: 'project'; entry: import('astro:content').CollectionEntry<'portfolio'> };
---

{kind === 'category' ? (
  <PortfolioCategoryPage entry={entry} />
) : (
  <PortfolioProjectPage entry={entry} />
)}
