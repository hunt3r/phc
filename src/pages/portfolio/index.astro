---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import { getNavTags, getTagMap, resolveTags } from '@/lib/tags';
import { createBreadcrumbListSchema } from '@/lib/seo/jsonld';

const portfolio = await getCollection('portfolio');
const sorted = portfolio.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const navTags = await getNavTags();
const tagMap = await getTagMap();
const siteEntry = await getEntry('site', 'index');
const portfolioTitle = siteEntry?.data?.portfolioTitle ?? 'Portfolio';
const site = Astro.url.origin || import.meta.env.SITE || "https://phandc.net";
const jsonLdNodes = [
  createBreadcrumbListSchema(site, [
    { name: "Home", path: "/" },
    { name: "Portfolio", path: "/portfolio" },
  ]),
];
---

<BaseLayout
  title={portfolioTitle}
  description="Explore our construction and development portfolio."
  jsonLdNodes={jsonLdNodes}
>
  <div class="pt-8 flex flex-col gap-8 lg:flex-row lg:gap-12">
    {/* Mobile: sticky dropdown below header */}
    <div
      class="sticky top-16 z-40 -mx-4 border-b border-gray-200 bg-white px-4 py-3 dark:border-gray-700 dark:bg-[#0a0a0a] sm:-mx-6 sm:px-6 lg:hidden"
      aria-label="Sections"
    >
      <label for="portfolio-tag-mobile" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Sections:</label>
      <select
        id="portfolio-tag-mobile"
        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-base text-gray-900 shadow-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-gray-500"
        data-portfolio-tag-select
      >
        <option value="/portfolio" selected>All</option>
        {navTags.map((t) => (
          <option value={`/tags/${t.id}`}>{t.data.label}</option>
        ))}
      </select>
    </div>
    <aside class="hidden shrink-0 lg:block lg:w-52">
      {/* Desktop: sidebar nav */}
      <nav aria-label="Sections" class="sticky top-28 space-y-1">
        <p class="mb-2 text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">
          Sections
        </p>
        <ul class="space-y-0.5">
          <li>
            <a
              href="/portfolio"
              class="block rounded-lg bg-primary/10 px-3 py-2 text-sm font-medium text-primary dark:bg-primary/20"
            >
              All
            </a>
          </li>
          {navTags.map((t) => (
            <li>
              <a
                href={`/tags/${t.id}`}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100"
              >
                {t.data.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
    <div class="min-w-0 flex-1 space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Portfolio</h1>
        <p class="mt-1 text-gray-600 dark:text-gray-400">
          {sorted.length} project{sorted.length === 1 ? '' : 's'}
        </p>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {sorted.map((entry) => (
          <li>
            <ProjectCard
              title={entry.data.title ?? ''}
              description={entry.data.description ?? ''}
              href={`/portfolio/${entry.id}`}
              imageSrc={entry.data.image}
              imageAlt={entry.data.title ?? ''}
              tags={resolveTags(entry, tagMap)}
              date={entry.data.date}
            />
          </li>
        ))}
      </ul>
    </div>
  </div>
  <script>
    document.querySelector('[data-portfolio-tag-select]')?.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      if (target?.value) window.location.href = target.value;
    });
  </script>
</BaseLayout>
