---
import { getImageUrl, getImageSrcSet } from "@/lib/cloudinary";

interface Image {
  src: string
  alt?: string
  /** Optional link (e.g. to another portfolio item), shown as a CTA button on the thumbnail and in the lightbox. */
  href?: string
  /** Optional CTA button label. Defaults to "View project". */
  ctaText?: string
}

interface Props {
  images: Image[]
  /** Optional unique id when multiple galleries exist on one page (e.g. portfolio slug). */
  galleryId?: string
  /** Heading shown above the grid. Pass an empty string to omit it (e.g. inside a content card). */
  heading?: string
  /** Wrapper section classes. Defaults to `mt-8`; pass "" to remove the top margin. */
  class?: string
  /** Responsive grid column classes for the thumbnail grid. Defaults to the full-width layout. */
  columnsClass?: string
}

const {
  images,
  galleryId = "default",
  heading = "Project gallery",
  class: sectionClass = "mt-8",
  columnsClass = "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4",
} = Astro.props as Props
const rootId = `portfolio-gallery-${galleryId}`
const lightboxId = `portfolio-lightbox-${galleryId}`
const lightboxImageId = `portfolio-lightbox-image-${galleryId}`

const THUMB_OPTIONS = { width: 400, quality: "auto:eco" as const };
const LIGHTBOX_OPTIONS = { width: 1200, quality: "auto:eco" as const };
const THUMB_WIDTHS = [320, 400, 640, 800];
const THUMB_SIZES = "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw";
const LIGHTBOX_WIDTHS = [640, 960, 1280, 1600, 1920, 2560];
const thumbImages = images.map((img) => ({
  src: getImageUrl(img.src, THUMB_OPTIONS),
  srcset: getImageSrcSet(img.src, THUMB_WIDTHS, { quality: "auto:eco" }),
  alt: img.alt,
  href: img.href?.trim() || undefined,
  ctaText: img.ctaText?.trim() || undefined,
}));
const lightboxImages = images.map((img) => ({
  src: getImageUrl(img.src, LIGHTBOX_OPTIONS),
  srcset: getImageSrcSet(img.src, LIGHTBOX_WIDTHS, { quality: "auto:eco" }),
  alt: img.alt,
  href: img.href?.trim() || undefined,
  ctaText: img.ctaText?.trim() || undefined,
}));
---

{images && images.length > 0 && (
  <section class={sectionClass}>
    {heading && <h2 class="mb-4 text-lg font-semibold text-gray-900">{heading}</h2>}
    <div
      id={rootId}
      class={`grid gap-3 ${columnsClass}`}
      data-images={JSON.stringify(lightboxImages)}
      data-gallery-id={galleryId}
    >
      {thumbImages.map((image, index) => (
        <div class="group relative overflow-hidden rounded-lg border border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
          <button
            type="button"
            class="block w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            data-index={index}
            aria-label={image.alt ? `View image: ${image.alt}` : "View image"}
          >
            <img
              src={image.src}
              srcset={image.srcset}
              sizes={THUMB_SIZES}
              alt={image.alt || ""}
              loading="lazy"
              class="h-40 w-full object-cover transition-transform duration-200 group-hover:scale-105"
            />
          </button>
          {image.href && (
            <a
              href={image.href}
              class="absolute bottom-2 left-1/2 z-10 -translate-x-1/2 rounded-full bg-primary px-3 py-1.5 text-sm font-medium text-white shadow hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
            >
              {image.ctaText || "View project"}
            </a>
          )}
        </div>
      ))}
    </div>

    <div
      id={lightboxId}
      class="pointer-events-none fixed inset-0 z-[60] flex items-center justify-center bg-black/70 opacity-0 transition-opacity duration-150"
      role="dialog"
      aria-modal="true"
      aria-label="Image gallery"
      aria-hidden="true"
      hidden
      inert
    >
      <div class="relative flex h-full w-full max-w-none flex-col rounded-none bg-black/80 p-2 text-white shadow-xl sm:p-4" id={`${lightboxId}-focus-root`} tabindex="-1">
        <button
          type="button"
          class="absolute right-2 top-2 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/50 text-white hover:bg-black/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white sm:right-3 sm:top-3"
          data-role="close"
          aria-label="Close gallery"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
        <button
          type="button"
          class="absolute left-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-white hover:bg-black/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white sm:left-3"
          data-role="prev"
          aria-label="Previous image"
        >
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          class="absolute right-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-white hover:bg-black/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white sm:right-3"
          data-role="next"
          aria-label="Next image"
        >
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
        <div class="flex h-full flex-1 items-center justify-center">
          <img
            id={lightboxImageId}
            src=""
            sizes="(min-width: 640px) calc(100vw - 2rem), calc(100vw - 1rem)"
            alt=""
            class="max-h-full w-auto max-w-full rounded-md object-contain"
          />
        </div>
        <a
          data-role="cta"
          href="#"
          class="absolute bottom-4 left-1/2 z-10 -translate-x-1/2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-white shadow hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
          hidden
        >View project</a>
        <div aria-live="polite" aria-atomic="true" class="sr-only" data-role="counter"></div>
      </div>
    </div>
  </section>
)}

<script>
  function initGalleries() {
  const galleryRoots = document.querySelectorAll("[data-gallery-id]");
  if (!galleryRoots.length) return;

  function getFocusables(container) {
    const sel = 'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
    return Array.from(container.querySelectorAll(sel));
  }

  function trapFocus(e, focusRoot) {
    if (e.key !== "Tab") return;
    const focusables = getFocusables(focusRoot);
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  galleryRoots.forEach((galleryRoot) => {
    const galleryId = galleryRoot.dataset.galleryId ?? "default";
    const lightbox = document.getElementById(`portfolio-lightbox-${galleryId}`);
    const lightboxImg = document.getElementById(`portfolio-lightbox-image-${galleryId}`);
    const focusRoot = document.getElementById(`portfolio-lightbox-${galleryId}-focus-root`);
    const counterEl = lightbox?.querySelector("[data-role=counter]");
    const ctaEl = lightbox?.querySelector("[data-role=cta]");
    if (!lightbox || !lightboxImg || !focusRoot) return;

    const images = JSON.parse(galleryRoot.dataset.images || "[]");
    let currentIndex = 0;
    let lastActiveThumb = null;
    let keyHandler = null;

    function updateCounter() {
      if (counterEl && images.length) counterEl.textContent = `Image ${currentIndex + 1} of ${images.length}`;
    }

    function updateCta() {
      if (!ctaEl) return;
      const img = images[currentIndex];
      if (img && img.href) {
        ctaEl.setAttribute("href", img.href);
        ctaEl.textContent = img.ctaText || "View project";
        ctaEl.removeAttribute("hidden");
      } else {
        ctaEl.setAttribute("hidden", "");
        ctaEl.removeAttribute("href");
      }
    }

    function openLightbox(index, thumb) {
      currentIndex = index;
      lastActiveThumb = thumb;
      const img = images[currentIndex];
      lightboxImg.src = img.src;
      if (img.srcset) lightboxImg.srcset = img.srcset;
      else lightboxImg.removeAttribute("srcset");
      lightboxImg.alt = img.alt || "";
      updateCounter();
      updateCta();
      lightbox.removeAttribute("hidden");
      lightbox.removeAttribute("inert");
      lightbox.classList.remove("pointer-events-none");
      lightbox.setAttribute("aria-hidden", "false");
      lightbox.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
      document.addEventListener("keydown", (keyHandler = (e) => {
        if (e.key === "Escape") {
          e.preventDefault();
          closeLightbox();
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          showNext(1);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          showNext(-1);
        } else if (e.key === "Tab") {
          trapFocus(e, focusRoot);
        }
      }));
      focusRoot.focus();
    }

    function closeLightbox() {
      lightbox.classList.add("pointer-events-none");
      lightbox.setAttribute("aria-hidden", "true");
      lightbox.classList.remove("opacity-100");
      lightbox.setAttribute("inert", "");
      lightbox.setAttribute("hidden", "");
      document.body.style.overflow = "";
      if (keyHandler) document.removeEventListener("keydown", keyHandler);
      keyHandler = null;
      if (lastActiveThumb) lastActiveThumb.focus();
    }

    function showNext(delta) {
      if (images.length === 0) return;
      currentIndex = (currentIndex + delta + images.length) % images.length;
      const img = images[currentIndex];
      lightboxImg.src = img.src;
      if (img.srcset) lightboxImg.srcset = img.srcset;
      else lightboxImg.removeAttribute("srcset");
      lightboxImg.alt = img.alt || "";
      updateCounter();
      updateCta();
    }

    galleryRoot.addEventListener("click", (event) => {
      const target = event.target;
      if (!target) return;
      const button = target.closest("button[data-index]");
      if (!button) return;
      const index = Number(button.dataset.index || "0");
      openLightbox(index, button);
    });

    lightbox.addEventListener("click", (event) => {
      const target = event.target;
      if (!target) return;
      const control = target.closest("[data-role]");
      if (control?.dataset.role === "close") {
        closeLightbox();
        return;
      }
      if (control?.dataset.role === "next") {
        showNext(1);
        return;
      }
      if (control?.dataset.role === "prev") {
        showNext(-1);
        return;
      }
      if (target === lightbox) {
        closeLightbox();
      }
    });
  });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGalleries);
  } else {
    initGalleries();
  }
</script>

