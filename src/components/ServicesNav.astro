---
import { getServicesNavTree } from '@/lib/tags';
import LeftNav from './LeftNav.astro';

interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;
const navTree = await getServicesNavTree();
---

<LeftNav
  navTree={navTree}
  activeId={activeId}
  label="Services"
  rootHref="/services"
  rootLabel="All services"
  selectId="services-tag-mobile"
/>
