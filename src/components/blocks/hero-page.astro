---
import { getImageUrl, getImageSrcSet } from '@/lib/cloudinary';

interface Props {
  id?: string;
  size?: 'full' | 'compact';
  eyebrow?: string;
  tagline?: string;
  subtitle?: string;
  ctaPrimaryText?: string;
  ctaPrimaryHref?: string;
  ctaSecondaryText?: string;
  ctaSecondaryHref?: string;
  backgroundImage?: string;
  overlayOpacity?: number;
  overlayColor?: 'dark' | 'light';
  /** Optional extra classes for the wrapper (e.g. a min-height like `min-h-[43vw]`). */
  class?: string;
}

const {
  id = 'hero',
  size = 'full',
  eyebrow,
  tagline,
  subtitle,
  ctaPrimaryText,
  ctaPrimaryHref,
  ctaSecondaryText,
  ctaSecondaryHref,
  backgroundImage,
  overlayOpacity = 70,
  overlayColor = 'dark',
  class: className,
} = Astro.props;

const HERO_IMAGE_OPTIONS = { width: 1920, quality: "auto:eco" as const };
const HERO_WIDTHS = [640, 960, 1280, 1600, 1920, 2560];
const backgroundImageUrl = backgroundImage ? getImageUrl(backgroundImage, HERO_IMAGE_OPTIONS) : undefined;
const backgroundImageSrcSet = backgroundImage
  ? getImageSrcSet(backgroundImage, HERO_WIDTHS, { quality: "auto:eco" })
  : undefined;
const clampedOpacity = Math.min(Math.max(overlayOpacity ?? 70, 0), 100);
const baseColor = overlayColor === 'light' ? '1 0 0' : '0 0 0';
const hasOverlay = Boolean(backgroundImageUrl);
const overlayIsDark = overlayColor === 'dark';
const textClass = hasOverlay
  ? (overlayIsDark ? 'text-white' : 'text-gray-900')
  : 'text-gray-900 dark:text-gray-100';
const mutedClass = hasOverlay
  ? (overlayIsDark ? 'text-white/80' : 'text-gray-900/80')
  : 'text-gray-600 dark:text-gray-400';
const secondaryBtnClass = hasOverlay
  ? (overlayIsDark
      ? 'btn border-2 border-white/80 text-white hover:bg-white/10 focus:ring-white focus:ring-offset-2 focus:ring-offset-transparent dark:focus:ring-offset-transparent'
      : 'btn border-2 border-gray-900/80 text-gray-900 hover:bg-gray-900/10 focus:ring-gray-900 focus:ring-offset-2 focus:ring-offset-transparent dark:focus:ring-offset-transparent')
  : 'btn btn-secondary';
const wrapperClass =
  size === 'full'
    ? 'relative min-h-[80vh] flex flex-col justify-center overflow-hidden'
    : 'relative flex flex-col justify-center overflow-hidden py-16 md:py-24';
---

<div
  id={id}
  class={`${wrapperClass} w-screen relative left-1/2 -translate-x-1/2${className ? ` ${className}` : ''}`}
>
  {backgroundImageUrl && (
    <img
      src={backgroundImageUrl}
      srcset={backgroundImageSrcSet}
      sizes="100vw"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
  )}
  {backgroundImageUrl && (
    <div
      class="absolute inset-0"
      style={`background: linear-gradient(to bottom, oklch(${baseColor} / ${clampedOpacity / 100}) 0%, oklch(${baseColor} / 0) 100%)`}
      aria-hidden="true"
    />
  )}
  <div class="relative flex flex-col justify-center items-center text-center px-4 py-12 md:py-16">
    <div class="mx-auto max-w-8xl w-full">
      {eyebrow && (
        <p class={`text-sm font-medium uppercase tracking-wider ${mutedClass}`}>
          {eyebrow}
        </p>
      )}
      {tagline && (
        <h1 class={`mt-2 text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl ${textClass}`}>
          {tagline}
        </h1>
      )}
      {subtitle && (
        <p class={`mt-4 text-lg max-w-2xl mx-auto ${mutedClass}`}>
          {subtitle}
        </p>
      )}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {ctaPrimaryText && ctaPrimaryHref && (
          <a href={ctaPrimaryHref} class="btn btn-primary">
            {ctaPrimaryText}
          </a>
        )}
        {ctaSecondaryText && ctaSecondaryHref && (
          <a href={ctaSecondaryHref} class={secondaryBtnClass}>
            {ctaSecondaryText}
          </a>
        )}
      </div>
    </div>
  </div>
</div>
