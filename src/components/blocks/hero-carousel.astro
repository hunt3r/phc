---
import { getImageUrl, getImageSrcSet } from '@/lib/cloudinary';

export interface HeroSlide {
  design?: 'slide' | 'banner';
  title: string;
  description?: string;
  eyebrow?: string;
  href?: string;
  ctaText?: string;
  ctaSecondaryText?: string;
  ctaSecondaryHref?: string;
  image?: string;
}

interface Props {
  id?: string;
  size?: 'full' | 'compact';
  slides: HeroSlide[];
  overlayOpacity?: number;
  overlayColor?: 'dark' | 'light';
  autoplayMs?: number;
}

const {
  id = 'hero',
  size = 'full',
  slides,
  overlayOpacity = 85,
  overlayColor = 'dark',
  autoplayMs = 6000,
} = Astro.props;

const HERO_QUALITY = 'auto:low' as const;
const HERO_IMAGE_OPTIONS = { width: 1920, quality: HERO_QUALITY, format: 'webp' as const };
const HERO_WIDTHS = [640, 768, 960, 1280, 1600, 1920, 2560];
const clampedOpacity = Math.min(Math.max(overlayOpacity ?? 85, 0), 100);
const baseColor = overlayColor === 'light' ? '1 0 0' : '0 0 0';
const overlayIsDark = overlayColor === 'dark';
const controlClass = 'text-white bg-brand-olive hover:bg-brand-olive/90 focus:ring-primary';
const textClassFor = (hasImage: boolean) =>
  hasImage ? (overlayIsDark ? 'text-white' : 'text-gray-900') : 'text-gray-900 dark:text-gray-100';
const mutedClassFor = (hasImage: boolean) =>
  hasImage ? (overlayIsDark ? 'text-white/80' : 'text-gray-900/80') : 'text-gray-600 dark:text-gray-400';
const secondaryClassFor = (hasImage: boolean) => {
  if (!hasImage) return 'btn btn-secondary';
  return overlayIsDark
    ? 'btn border-2 border-white/80 text-white hover:bg-white/10 focus:ring-white focus:ring-offset-2 focus:ring-offset-transparent'
    : 'btn border-2 border-gray-900/80 text-gray-900 hover:bg-gray-900/10 focus:ring-gray-900 focus:ring-offset-2 focus:ring-offset-transparent';
};

const wrapperClass =
  size === 'full'
    ? 'relative min-h-[80vh] flex flex-col justify-center overflow-hidden'
    : 'relative flex flex-col justify-center overflow-hidden py-16 md:py-24';

const resolvedSlides = slides.map((slide) => {
  const design = slide.design === 'banner' ? 'banner' : 'slide';
  const image = slide.image?.trim() || undefined;
  const imageUrl = image ? getImageUrl(image, HERO_IMAGE_OPTIONS) : undefined;
  const title = slide.title?.trim() ?? '';
  const primaryText = slide.ctaText?.trim() || (design === 'slide' && title ? `View ${title}` : '');
  const showPrimary = Boolean(slide.href && primaryText);
  const showSecondary = design === 'banner' && Boolean(slide.ctaSecondaryText && slide.ctaSecondaryHref);
  return {
    ...slide,
    design,
    image,
    imageUrl,
    imageAvifSrcSet: image ? getImageSrcSet(image, HERO_WIDTHS, { quality: HERO_QUALITY, format: 'avif' }) : undefined,
    imageWebpSrcSet: image ? getImageSrcSet(image, HERO_WIDTHS, { quality: HERO_QUALITY, format: 'webp' }) : undefined,
    hasImage: Boolean(imageUrl),
    showPrimary,
    primaryText,
    showSecondary,
    label: slide.title || slide.eyebrow || 'Slide',
  };
});
const multiple = resolvedSlides.length > 1;
---

<section
  id={id}
  class={`${wrapperClass} w-screen left-1/2 -translate-x-1/2`}
  data-hero-carousel
  data-autoplay={multiple ? autoplayMs : 0}
  aria-roledescription="carousel"
  aria-label="Featured"
>
  <div class="relative w-full">
    {resolvedSlides.map((slide, index) => (
      <div
        class="hero-slide inset-0 overflow-hidden transition-opacity duration-700 motion-reduce:transition-none"
        class:list={[index === 0 ? 'relative opacity-100' : 'absolute opacity-0 pointer-events-none']}
        data-hero-slide
        data-active={index === 0 ? 'true' : 'false'}
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} of ${resolvedSlides.length}: ${slide.label}`}
        aria-hidden={index === 0 ? 'false' : 'true'}
        inert={index !== 0}
      >
        {slide.imageUrl && (
          <picture>
            {slide.imageAvifSrcSet && (
              <source
                type="image/avif"
                srcset={index === 0 ? slide.imageAvifSrcSet : undefined}
                data-srcset={slide.imageAvifSrcSet}
                sizes="100vw"
              />
            )}
            {slide.imageWebpSrcSet && (
              <source
                type="image/webp"
                srcset={index === 0 ? slide.imageWebpSrcSet : undefined}
                data-srcset={slide.imageWebpSrcSet}
                sizes="100vw"
              />
            )}
            <img
              src={index === 0 ? slide.imageUrl : undefined}
              srcset={index === 0 ? slide.imageWebpSrcSet : undefined}
              data-src={slide.imageUrl}
              data-srcset={slide.imageWebpSrcSet}
              sizes="100vw"
              alt={slide.title || slide.eyebrow || ""}
              aria-hidden="true"
              width="1920"
              height="1080"
              fetchpriority={index === 0 ? 'high' : undefined}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </picture>
        )}
        {slide.hasImage && (
          <div
            class="absolute inset-0"
            style={`background: linear-gradient(to bottom, oklch(${baseColor} / ${clampedOpacity / 100}) 0%, oklch(${baseColor} / 0) 100%)`}
            aria-hidden="true"
          />
        )}
        <div class={`relative flex ${size === 'full' ? 'min-h-[80vh]' : ''} flex-col justify-center items-center text-center px-4 py-12 md:py-16`}>
          <div class="mx-auto max-w-8xl w-full">
            {slide.design === 'banner' && slide.eyebrow && (
              <p class={`text-sm font-medium uppercase tracking-wider ${mutedClassFor(slide.hasImage)}`}>
                {slide.eyebrow}
              </p>
            )}
            {slide.title && (
              index === 0 ? (
                <h1 class={`font-heading text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl ${textClassFor(slide.hasImage)} ${slide.design === 'banner' && slide.eyebrow ? 'mt-2' : ''}`}>
                  {slide.title}
                </h1>
              ) : (
                <p class={`font-heading text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl ${textClassFor(slide.hasImage)} ${slide.design === 'banner' && slide.eyebrow ? 'mt-2' : ''}`}>
                  {slide.title}
                </p>
              )
            )}
            {slide.description && (
              <p class={`mt-4 text-lg max-w-2xl mx-auto ${slide.design === 'slide' ? 'line-clamp-3' : ''} ${mutedClassFor(slide.hasImage)}`}>
                {slide.description}
              </p>
            )}
            {(slide.showPrimary || slide.showSecondary) && (
              <div class="mt-8 flex flex-wrap justify-center gap-3">
                {slide.showPrimary && (
                  <a href={slide.href} class="btn btn-primary">
                    {slide.primaryText}
                  </a>
                )}
                {slide.showSecondary && (
                  <a href={slide.ctaSecondaryHref} class={secondaryClassFor(slide.hasImage)}>
                    {slide.ctaSecondaryText}
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    ))}

    {multiple && (
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex items-center gap-3">
        <button
          type="button"
          data-hero-prev
          class={`grid place-items-center h-10 w-10 rounded-full transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-transparent ${controlClass}`}
          aria-label="Previous slide"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="flex gap-2" role="tablist" aria-label="Choose slide">
          {resolvedSlides.map((slide, index) => (
            <button
              type="button"
              data-hero-dot
              data-index={index}
              class="group grid place-items-center h-6 w-6 rounded-full transition focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-transparent"
              data-active={index === 0 ? 'true' : 'false'}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={`Go to slide ${index + 1}: ${slide.label}`}
            >
              <span
                class="h-2.5 w-2.5 rounded-full bg-white/50 transition group-hover:bg-white/80 group-data-[active=true]:bg-white"
                aria-hidden="true"
              />
            </button>
          ))}
        </div>
        <button
          type="button"
          data-hero-next
          class={`grid place-items-center h-10 w-10 rounded-full transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-transparent ${controlClass}`}
          aria-label="Next slide"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    )}
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll('[data-hero-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-hero-dot]'));
    if (slides.length <= 1) return;

    const autoplayMs = Number((root as HTMLElement).dataset.autoplay ?? 0);
    let current = 0;
    let timer: number | undefined;
    let preloadTimer: number | undefined;
    // Start the upcoming slide just before it fades in. The rest stay unloaded.
    const PRELOAD_LEAD_MS = 1500;

    // Hidden slides cover the hero, so loading="lazy" does not defer them.
    // Leave src empty until that slide is on screen.
    const ensureLoaded = (index: number) => {
      const total = slides.length;
      const i = ((index % total) + total) % total;
      const slide = slides[i];
      const img = slide?.querySelector('img');
      if (!(img instanceof HTMLImageElement) || img.getAttribute('src')) return;
      const src = img.dataset.src;
      if (!src) return;
      slide?.querySelectorAll('source').forEach((source) => {
        if (source.dataset.srcset) source.srcset = source.dataset.srcset;
      });
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = src;
    };

    const cancelPreload = () => {
      if (preloadTimer !== undefined) {
        window.clearTimeout(preloadTimer);
        preloadTimer = undefined;
      }
    };

    const armPreload = () => {
      cancelPreload();
      if (reduceMotion || !autoplayMs) return;
      const delay = Math.max(0, autoplayMs - PRELOAD_LEAD_MS);
      preloadTimer = window.setTimeout(() => ensureLoaded(current + 1), delay);
    };

    const show = (next: number) => {
      const total = slides.length;
      const index = ((next % total) + total) % total;
      ensureLoaded(index);
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('relative', active);
        slide.classList.toggle('absolute', !active);
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.classList.toggle('pointer-events-none', !active);
        (slide as HTMLElement).dataset.active = active ? 'true' : 'false';
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        if (active) slide.removeAttribute('inert');
        else slide.setAttribute('inert', '');
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        (dot as HTMLElement).dataset.active = active ? 'true' : 'false';
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      current = index;
      armPreload();
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
      cancelPreload();
    };

    const start = () => {
      if (reduceMotion || !autoplayMs) return;
      stop();
      timer = window.setInterval(() => show(current + 1), autoplayMs);
      armPreload();
    };

    root.querySelector('[data-hero-prev]')?.addEventListener('click', () => {
      show(current - 1);
      start();
    });
    root.querySelector('[data-hero-next]')?.addEventListener('click', () => {
      show(current + 1);
      start();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      })
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (event) => {
      if (root.contains((event as FocusEvent).relatedTarget as Node | null)) return;
      start();
    });

    start();
  });
</script>
