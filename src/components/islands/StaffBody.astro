---
/**
 * Editable island renderer for the Staff document (a single list of people).
 * Used by the About page's "Key Personnel" region.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import { getImageUrl } from '@/lib/cloudinary';
import type { StaffQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: StaffQuery['staff'] | null;
}

const { data } = Astro.props;
const staff = data?.staff ?? [];

const initialsOf = (name?: string | null) =>
  (name ?? '')
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

{data && (
  <section class="pt-4">
    <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">Key Personnel</h2>
    <div class="grid grid-cols-1 gap-6">
      {staff.map((member) =>
        member ? (
          <div class="grid grid-cols-1 gap-4 rounded-xl border border-gray-200 p-5 sm:grid-cols-[12rem_1fr] sm:gap-6 dark:border-gray-700">
            <div class="flex flex-col items-center gap-3 text-center">
              <div
                class="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gray-100 text-xl font-semibold text-gray-500 sm:h-28 sm:w-28 dark:bg-gray-800 dark:text-gray-400"
                data-tina-field={tinaField(member, 'image')}
              >
                {member.image ? (
                  <img
                    src={getImageUrl(member.image, { width: 112, height: 112, crop: 'fill' })}
                    alt=""
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  initialsOf(member.name)
                )}
              </div>
              <div>
                <p class="text-lg font-semibold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(member, 'name')}>
                  {member.name}
                </p>
                <p class="mt-0.5 text-sm text-primary" data-tina-field={tinaField(member, 'title')}>
                  {member.title}
                </p>
                {member.note && (
                  <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400" data-tina-field={tinaField(member, 'note')}>
                    {member.note}
                  </p>
                )}
              </div>
            </div>
            {member.bio && (
              <div class="space-y-2 text-sm text-gray-600 dark:text-gray-300" data-tina-field={tinaField(member, 'bio')}>
                {member.bio.split(/\n\n+/).filter(Boolean).map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            )}
          </div>
        ) : null
      )}
    </div>
  </section>
)}
