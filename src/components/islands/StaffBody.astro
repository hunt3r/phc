---
/**
 * Editable island renderer for the Staff document (a single list of people).
 * Used by the About page's "Key Personnel" grid.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import { getImageUrl, isCloudinarySrc } from '@/lib/cloudinary';
import { withStaffSlugs } from '@/data/staff';
import type { StaffQuery } from '../../../tina/__generated__/types';

const CARD_WIDTHS = [320, 480, 640, 960];
const CARD_SIZES = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1280px) 33vw, 25vw';

interface Props {
  data?: StaffQuery['staff'] | null;
}

const { data } = Astro.props;
const members = (data?.staff ?? []).flatMap((member) => (member?.name ? [member] : []));
const slugged = withStaffSlugs(members);

const initialsOf = (name?: string | null) =>
  (name ?? '')
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

{data && (
  <section class="pt-4">
    <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">Key Personnel</h2>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {slugged.map((person, index) => {
        const member = members[index];
        const image = member.image;
        return (
        <li>
          <a
            href={`/about/${person.slug}`}
            class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white text-gray-900 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100"
          >
            <div
              class="flex aspect-square w-full items-center justify-center overflow-hidden bg-gray-100 text-3xl font-semibold text-gray-500 dark:bg-gray-700 dark:text-gray-400"
              data-tina-field={tinaField(member, 'image')}
            >
              {image ? (
                <img
                  src={getImageUrl(image, { width: 640, height: 640, crop: 'fill' })}
                  srcset={
                    isCloudinarySrc(image)
                      ? CARD_WIDTHS.map(
                          (width) =>
                            `${getImageUrl(image, { width, height: width, crop: 'fill' })} ${width}w`
                        ).join(', ')
                      : undefined
                  }
                  sizes={CARD_SIZES}
                  alt=""
                  class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
                  width="640"
                  height="640"
                  loading="lazy"
                />
              ) : (
                initialsOf(member.name)
              )}
            </div>
            <div class="flex flex-1 flex-col gap-1 p-5">
              <h3
                class="text-base font-semibold tracking-tight text-gray-900 dark:text-gray-100"
                data-tina-field={tinaField(member, 'name')}
              >
                {member.name}
              </h3>
              <p class="text-sm text-primary" data-tina-field={tinaField(member, 'title')}>
                {member.title}
              </p>
            </div>
          </a>
        </li>
        );
      })}
    </ul>
  </section>
)}
