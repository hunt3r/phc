---
/**
 * Editable island renderer for the Staff document (a single list of people).
 * Used by the About page's "Key Personnel" region.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import type { StaffQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: StaffQuery['staff'] | null;
}

const { data } = Astro.props;
const staff = data?.staff ?? [];
---

{data && (
  <section class="pt-4">
    <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">Key Personnel</h2>
    <div class="grid grid-cols-1 gap-6">
      {staff.map((member) =>
        member ? (
          <div class="flex flex-col gap-1 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
            <p class="text-lg font-semibold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(member, 'name')}>
              {member.name}
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300" data-tina-field={tinaField(member, 'title')}>
              {member.title}
            </p>
            {member.bio && (
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400" data-tina-field={tinaField(member, 'bio')}>
                {member.bio}
              </p>
            )}
          </div>
        ) : null
      )}
    </div>
  </section>
)}
