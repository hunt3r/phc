---
/**
 * Editable island renderer for the About page document. The About `body` is a
 * plain-string (textarea) field in the schema, so it is rendered as text rather
 * than through TinaMarkdown.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import type { AboutQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: AboutQuery['about'] | null;
}

const { data } = Astro.props;
const hero = data?.hero;
---

{data && (
  <article class="pt-8 space-y-8">
    <header class="space-y-3">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(data, 'title')}>
        {data.title}
      </h1>
      {hero?.tagline && (
        <p class="text-xl text-gray-700 dark:text-gray-200" data-tina-field={tinaField(hero, 'tagline')}>
          {hero.tagline}
        </p>
      )}
      {hero?.subtitle && (
        <p class="text-gray-600 dark:text-gray-300" data-tina-field={tinaField(hero, 'subtitle')}>
          {hero.subtitle}
        </p>
      )}
    </header>

    {data.body && (
      <section class="prose-content whitespace-pre-wrap" data-tina-field={tinaField(data, 'body')}>
        {data.body}
      </section>
    )}
  </article>
)}
