---
/**
 * Editable island renderer for the global Site Settings document. These are
 * primarily SEO/browser titles; the portfolio index heading is exposed here so
 * there is a visible, clickable target inside the editor.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import type { SiteQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: SiteQuery['site'] | null;
}

const { data } = Astro.props;
---

{data && (
  <div>
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(data, 'portfolioTitle')}>
      {data.portfolioTitle ?? 'Portfolio'}
    </h1>
  </div>
)}
