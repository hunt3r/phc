---
/**
 * Editable island renderer for a portfolio project.
 *
 * Rendered inside the admin iframe (and by the `/tina-island/portfolio`
 * endpoint) against Tina query data. Every editable element carries a
 * `data-tina-field` marker so clicking it focuses the matching form field.
 * The public build still renders the project via `PortfolioProjectPage.astro`
 * from `astro:content`; this component is the live-overlay counterpart.
 */
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaMarkdownComponents } from '@/lib/tinaMarkdown';
import { tinaField } from '@tinacms/astro/tina-field';
import { getImageUrl } from '@/lib/cloudinary';
import { getTagMap, resolveTagsGrouped } from '@/lib/tags';
import { getEntityMap, resolveCredits, type EntityCredit } from '@/lib/entities';
import ProjectSpecs from '../ProjectSpecs.astro';
import ProjectTagLinks from '../ProjectTagLinks.astro';
import ContentCardsBody from './ContentCardsBody.astro';
import type { CollectionEntry } from 'astro:content';
import type { PortfolioQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: PortfolioQuery['portfolio'] | null;
}

const { data } = Astro.props;

const entityMap = await getEntityMap();

/**
 * The role list itself is not a useful click target: Tina zooms into the
 * list and the sidebar goes blank. Point each party at its own record so a
 * click opens that entity.
 */
function previewCredits(value: unknown): EntityCredit[] {
  if (!Array.isArray(value)) return [];
  const credits: EntityCredit[] = [];
  for (const item of value) {
    const credit = resolveCredits([item], entityMap)[0];
    if (!credit) continue;
    const entity =
      item && typeof item === 'object' && 'entity' in item ? (item as { entity?: unknown }).entity : item;
    const field =
      entity && typeof entity === 'object' ? tinaField(entity as Parameters<typeof tinaField>[0], 'name') : '';
    credits.push(field ? { ...credit, field } : credit);
  }
  return credits;
}
const gallery = (data?.gallery ?? []).filter((img): img is NonNullable<typeof img> => Boolean(img?.src));
const tagGroups = data
  ? resolveTagsGrouped(
      { data: { sectors: data.sectors ?? [], services: data.services ?? [] } } as CollectionEntry<'portfolio'>,
      await getTagMap(),
    )
  : [];
---

{data && (
  <article class="space-y-8">
    <h1 class="mt-4 text-3xl font-bold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(data, 'title')}>
      {data.title}
    </h1>
    <section class="prose-content [&::after]:clear-both [&::after]:table [&::after]:content-['']">
      <ProjectSpecs
        location={data.location}
        client={previewCredits(data.client)}
        date={data.date}
        projectCost={data.projectCost}
        size={data.size}
        architect={previewCredits(data.architect)}
        engineer={previewCredits(data.engineer)}
        contractor={previewCredits(data.contractor)}
        fields={{
          location: tinaField(data, 'location'),
          date: tinaField(data, 'date'),
          projectCost: tinaField(data, 'projectCost'),
          size: tinaField(data, 'size'),
        }}
        class="mb-6 w-full md:float-right md:mb-4 md:ml-8 md:w-80 lg:w-96"
      />
      <div data-tina-field={tinaField(data, 'body')}>
        <TinaMarkdown content={data.body} components={tinaMarkdownComponents} />
      </div>
    </section>

    <ContentCardsBody cards={data.contentCards} sectionId="portfolio-card" allowFullBleed={true} />

    {gallery.length > 0 && (
      <section class="mt-8" data-tina-field={tinaField(data, 'gallery')}>
        <div class="rounded-xl bg-[#f4f2ee] px-4 py-6 ring-1 ring-[#e4dfd6] sm:px-6 dark:bg-[#161616] dark:ring-gray-700">
        <h2 class="font-heading mb-5 text-2xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">
          Project gallery
        </h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
          {gallery.map((img) => (
            <div
              class="overflow-hidden rounded-lg bg-gray-50 ring-1 ring-gray-200 dark:bg-gray-800 dark:ring-gray-700"
              data-tina-field={tinaField(img, 'src')}
            >
              <img
                src={getImageUrl(img.src, { width: 400, quality: 'auto:eco' })}
                alt={img.alt ?? ''}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full object-cover"
              />
            </div>
          ))}
        </div>
        </div>
      </section>
    )}

    {data.quotes && data.quotes.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Testimonials</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {data.quotes.map((q) =>
            q ? (
              <figure class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
                <blockquote data-tina-field={tinaField(q, 'quote')}>{q.quote}</blockquote>
                {q.author && (
                  <figcaption class="mt-2 text-sm text-gray-500" data-tina-field={tinaField(q, 'author')}>
                    {q.author}
                  </figcaption>
                )}
              </figure>
            ) : null
          )}
        </div>
      </section>
    )}

    <ProjectTagLinks groups={tagGroups} />
  </article>
)}
