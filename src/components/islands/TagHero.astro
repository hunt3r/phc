---
/**
 * Editable island renderer for a tag's hero region, used on the custom-template
 * landing pages (`/portfolio` and `/services`) that render a root tag through
 * `HeroPage` rather than the generic category layout. Exposes the tag's own
 * fields — image, label, description — so they are click-to-editable and the
 * tag form loads on those pages.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import { getImageSrcSet, getImageUrl } from '@/lib/cloudinary';
import type { TagsQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: TagsQuery['tags'] | null;
}

const { data } = Astro.props;
const heroImage = data?.image?.trim();
const heroSrc = heroImage ? getImageUrl(heroImage, { width: 1600 }) : undefined;
const heroSrcSet = heroImage ? getImageSrcSet(heroImage, [640, 960, 1280, 1600, 1920]) : undefined;
---

{data && (
  <section class="space-y-4">
    {heroSrc && (
      <img
        src={heroSrc}
        srcset={heroSrcSet}
        sizes="(min-width: 90rem) 86rem, 100vw"
        alt={data.label}
        width="1600"
        height="686"
        class="aspect-[21/9] w-full rounded-lg object-cover"
        data-tina-field={tinaField(data, 'image')}
      />
    )}
    <div class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(data, 'label')}>
        {data.label}
      </h1>
      {data.description && (
        <p class="max-w-3xl text-lg text-gray-600 dark:text-gray-400" data-tina-field={tinaField(data, 'description')}>
          {data.description}
        </p>
      )}
    </div>
  </section>
)}
