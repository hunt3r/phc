---
/**
 * Editable banner for a Pages or Contact document. Renders only when Featured
 * Image is set. When it is blank, PageHeading shows the title below the
 * breadcrumb instead, so the two islands never both show an H1.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import HeroPage from '../blocks/hero-page.astro';
import { hasFeaturedImage, type PageHeaderDocument } from '@/lib/page-header';

interface Props {
  data?: PageHeaderDocument | null;
  id?: string;
}

const { data, id = 'page-hero' } = Astro.props;
const featuredImage = data?.featuredImage?.trim();
const description = data?.description?.trim();
---

{data && hasFeaturedImage(featuredImage) && (
  <HeroPage
    id={id}
    size="compact"
    tagline={data.title ?? ''}
    subtitle={description}
    backgroundImage={featuredImage}
    overlayOpacity={70}
    overlayColor="dark"
    imageField={tinaField(data, 'featuredImage')}
    titleField={tinaField(data, 'title')}
    subtitleField={description ? tinaField(data, 'description') : undefined}
  />
)}
