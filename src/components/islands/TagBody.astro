---
/**
 * Editable island renderer for a tag / portfolio-category document.
 * Renders the tag's own editable fields (label, description, body); the
 * cross-collection project listing on the public category page is not
 * editable in place and is omitted here.
 */
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { TagsQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: TagsQuery['tags'] | null;
}

const { data } = Astro.props;
---

{data && (
  <div class="min-w-0 flex-1 space-y-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(data, 'label')}>
        {data.label}
      </h1>
      {data.description && (
        <p class="mt-1 text-gray-600 dark:text-gray-400" data-tina-field={tinaField(data, 'description')}>
          {data.description}
        </p>
      )}
    </div>

    <section class="prose-content" data-tina-field={tinaField(data, 'body')}>
      <TinaMarkdown content={data.body} />
    </section>
  </div>
)}
