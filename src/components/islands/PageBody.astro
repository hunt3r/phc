---
/**
 * Editable island renderer for a `pages` collection document (e.g. contact,
 * privacy-policy). The page island wraps only the body `prose-content` section
 * on the page, so this renders just the rich-text body via `<TinaMarkdown>`
 * (the header is rendered separately by the page's hero).
 */
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { PagesQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: PagesQuery['pages'] | null;
}

const { data } = Astro.props;
---

{data && (
  <section class="prose-content prose-img:rounded-lg" data-tina-field={tinaField(data, 'body')}>
    <TinaMarkdown content={data.body} />
  </section>
)}
