---
/**
 * Editable island renderer for a `pages` or `contact` document body. The
 * banner (`PageHero`) and the in-page title (`PageHeading`) are separate
 * islands, so this renders only the rich-text body.
 */
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaMarkdownComponents } from '@/lib/tinaMarkdown';
import { tinaField } from '@tinacms/astro/tina-field';
import type { PagesQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: PagesQuery['pages'] | null;
}

const { data } = Astro.props;
---

{data && (
  <section class="prose-content prose-img:rounded-lg" data-tina-field={tinaField(data, 'body')}>
    <TinaMarkdown content={data.body} components={tinaMarkdownComponents} />
  </section>
)}
