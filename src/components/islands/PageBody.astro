---
/**
 * Editable island renderer for a `pages` collection document (e.g. contact,
 * privacy-policy). The page `body` is a plain-string (textarea) field, so it is
 * rendered as text rather than through TinaMarkdown.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import type { PagesQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: PagesQuery['pages'] | null;
}

const { data } = Astro.props;
const hero = data?.hero;
---

{data && (
  <article class="pt-8 space-y-8">
    <header class="space-y-3">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100" data-tina-field={tinaField(data, 'title')}>
        {data.title}
      </h1>
      {data.description && (
        <p class="text-gray-600 dark:text-gray-300" data-tina-field={tinaField(data, 'description')}>
          {data.description}
        </p>
      )}
      {hero?.subtitle && (
        <p class="text-gray-600 dark:text-gray-300" data-tina-field={tinaField(hero, 'subtitle')}>
          {hero.subtitle}
        </p>
      )}
    </header>

    {data.body && (
      <section class="prose-content whitespace-pre-wrap" data-tina-field={tinaField(data, 'body')}>
        {data.body}
      </section>
    )}
  </article>
)}
