---
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Services', href: '/services' },
  { label: 'Project Sectors', href: '/project-sectors' },
  { label: 'Testimonials', href: '/testimonials' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-[#0a0a0a]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 lg:grid-cols-4">
      <!-- Brand + social -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2" aria-label="PHC Home">
          <img src="/images/logo-light.png" alt="PH&C" class="h-10 w-auto dark:hidden" width="1462" height="324" />
          <img src="/images/logo-dark.png" alt="PH&C" class="h-10 w-auto hidden dark:block" width="1462" height="324" />
        </a>
        <p class="mt-4 max-w-sm text-sm text-gray-600 dark:text-gray-400">
          Delivering quality construction and project management across retail, healthcare, government, and commercial sectors.
        </p>
        <div class="mt-5 flex items-center gap-2">
          <a
            href="https://www.linkedin.com/company/ph-c-llc/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="PH&C on LinkedIn"
            class="inline-flex items-center justify-center rounded-lg p-2 text-primary hover:bg-primary/10 focus:outline-none focus:ring-2 focus:ring-primary/50"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@phcllc"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="PH&C on YouTube"
            class="inline-flex items-center justify-center rounded-lg p-2 text-primary hover:bg-primary/10 focus:outline-none focus:ring-2 focus:ring-primary/50"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigate -->
      <nav aria-label="Footer">
        <h2 class="subheading text-sm text-gray-500 dark:text-gray-400">Navigate</h2>
        <ul class="mt-4 space-y-2">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-primary hover:text-primary/80">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h2 class="subheading text-sm text-gray-500 dark:text-gray-400">Contact</h2>
        <address class="mt-4 space-y-2 text-sm not-italic text-gray-600 dark:text-gray-400">
          <p class="font-medium text-gray-900 dark:text-gray-100">PH&amp;C, LLC</p>
          <p>998 Old Eagle School Road, Suite 1210</p>
          <p>Wayne, PA 19087</p>
          <p>
            <a href="mailto:info@phandc.net" class="text-primary hover:text-primary/80">info@phandc.net</a>
          </p>
        </address>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col gap-2 border-t border-gray-200 pt-6 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} PH&amp;C, LLC. All rights reserved.</p>
      <a href="/privacy-policy" class="text-primary hover:text-primary/80">Privacy Policy</a>
    </div>
  </div>
</footer>
