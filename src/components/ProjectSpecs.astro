---
import { getImageUrl } from '@/lib/cloudinary';
import type { EntityCredit } from '@/lib/entities';

interface Props {
  location?: string | null;
  client?: EntityCredit[] | null;
  date?: string | null;
  projectCost?: string | null;
  size?: string | null;
  architect?: EntityCredit[] | null;
  engineer?: EntityCredit[] | null;
  contractor?: EntityCredit[] | null;
  class?: string;
  /** `data-tina-field` values so the live preview can focus each spec. */
  fields?: {
    location?: string;
    client?: string;
    date?: string;
    projectCost?: string;
    size?: string;
    architect?: string;
    engineer?: string;
    contractor?: string;
  };
}

const {
  location,
  client,
  date,
  projectCost,
  size,
  architect,
  engineer,
  contractor,
  class: className,
  fields,
} = Astro.props as Props;

const specs = [
  { label: 'Location', text: location, credits: undefined as EntityCredit[] | undefined, field: fields?.location },
  { label: 'Client', text: undefined as string | null | undefined, credits: client ?? undefined, field: fields?.client },
  { label: 'Date', text: date, credits: undefined as EntityCredit[] | undefined, field: fields?.date },
  { label: 'Project Cost', text: projectCost, credits: undefined as EntityCredit[] | undefined, field: fields?.projectCost },
  { label: 'Size', text: size, credits: undefined as EntityCredit[] | undefined, field: fields?.size },
  { label: 'Architect', text: undefined as string | null | undefined, credits: architect ?? undefined, field: fields?.architect },
  { label: 'Engineer', text: undefined as string | null | undefined, credits: engineer ?? undefined, field: fields?.engineer },
  { label: 'Contractor', text: undefined as string | null | undefined, credits: contractor ?? undefined, field: fields?.contractor },
].filter((spec) => (spec.credits ? spec.credits.length > 0 : Boolean(spec.text && spec.text.trim().length > 0)));
---

{specs.length > 0 && (
  <aside
    class:list={[
      'not-prose @container overflow-hidden rounded-xl border border-[#2a4258] bg-[#101922] text-[#f7f4ee] shadow-md shadow-black/15',
      className,
    ]}
    aria-label="Project details"
  >
    <h2 class="font-heading relative m-0 bg-gradient-to-b from-[#14588a] via-[#0d3f66] to-[#101922] px-5 pb-3.5 pt-4 text-lg font-semibold tracking-tight text-white">
      Project Details
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-[#e8d49a] to-transparent"
      />
    </h2>
    <dl class="m-0 divide-y divide-white/10">
      {specs.map((spec) => (
        <div class="bg-[#101922] px-5 py-3 @min-[18.5rem]:flex @min-[18.5rem]:items-baseline @min-[18.5rem]:gap-3">
          <dt class="subheading m-0 text-[0.6875rem] font-semibold leading-5 text-[#f0e0b0] @min-[18.5rem]:w-[6.75rem] @min-[18.5rem]:shrink-0">
            {spec.label}
          </dt>
          <dd
            class="m-0 mt-0.5 min-w-0 text-[0.9375rem] leading-snug font-medium break-words text-[#f7f4ee] @min-[18.5rem]:mt-0 @min-[18.5rem]:flex-1"
            data-tina-field={spec.credits ? undefined : spec.field}
          >
            {spec.credits ? (
              <span class="inline-flex max-w-full flex-wrap items-center gap-x-1 gap-y-1">
                {spec.credits.map((credit, index) => (
                  <span class="inline-flex items-center gap-1.5" data-tina-field={credit.field}>
                    {credit.logo && (
                      <img
                        src={getImageUrl(credit.logo, { width: 64, height: 64, crop: 'fit' })}
                        alt=""
                        width="20"
                        height="20"
                        class="h-5 w-5 shrink-0 rounded-sm bg-white object-contain p-0.5"
                      />
                    )}
                    <span>
                      {credit.url ? (
                        <a
                          href={credit.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-inherit underline decoration-white/40 underline-offset-2 hover:decoration-white"
                        >
                          {credit.name}
                          <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                      ) : (
                        credit.name
                      )}
                      {index < spec.credits.length - 1 && ','}
                    </span>
                  </span>
                ))}
              </span>
            ) : (
              spec.text
            )}
          </dd>
        </div>
      ))}
    </dl>
  </aside>
)}
