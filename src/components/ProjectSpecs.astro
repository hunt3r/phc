---
interface Props {
  projectCost?: string;
  size?: string;
  architect?: string;
  contractor?: string;
  class?: string;
}

const { projectCost, size, architect, contractor, class: className } = Astro.props as Props;

const specs = [
  { label: 'Project Cost', value: projectCost },
  { label: 'Size', value: size },
  { label: 'Architect', value: architect },
  { label: 'Contractor', value: contractor },
].filter((spec) => spec.value && spec.value.trim().length > 0);
---

{specs.length > 0 && (
  <aside
    class={`overflow-hidden rounded-xl border border-gray-700 bg-gray-900 text-gray-100 shadow-sm ${className ?? ''}`}
    aria-label="Project details"
  >
    <dl class="divide-y divide-white/10">
      {specs.map((spec) => (
        <div class="flex flex-col gap-1 px-6 py-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="text-xs font-semibold uppercase tracking-wider text-primary">{spec.label}</dt>
          <dd class="text-base font-medium text-white sm:text-right">{spec.value}</dd>
        </div>
      ))}
    </dl>
  </aside>
)}
