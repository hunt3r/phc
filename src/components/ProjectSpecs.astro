---
interface Props {
  location?: string | null;
  client?: string | null;
  date?: string | null;
  projectCost?: string | null;
  size?: string | null;
  architect?: string | null;
  engineer?: string | null;
  contractor?: string | null;
  class?: string;
  /** `data-tina-field` values so the live preview can focus each spec. */
  fields?: {
    location?: string;
    client?: string;
    date?: string;
    projectCost?: string;
    size?: string;
    architect?: string;
    engineer?: string;
    contractor?: string;
  };
}

const {
  location,
  client,
  date,
  projectCost,
  size,
  architect,
  engineer,
  contractor,
  class: className,
  fields,
} = Astro.props as Props;

const specs = [
  { label: 'Location', value: location, field: fields?.location },
  { label: 'Client', value: client, field: fields?.client },
  { label: 'Date', value: date, field: fields?.date },
  { label: 'Project Cost', value: projectCost, field: fields?.projectCost },
  { label: 'Size', value: size, field: fields?.size },
  { label: 'Architect', value: architect, field: fields?.architect },
  { label: 'Engineer', value: engineer, field: fields?.engineer },
  { label: 'Contractor', value: contractor, field: fields?.contractor },
].filter((spec) => spec.value && spec.value.trim().length > 0);
---

{specs.length > 0 && (
  <aside
    class={`overflow-hidden rounded-xl border border-gray-700 bg-gray-900 text-gray-100 shadow-sm ${className ?? ''}`}
    aria-label="Project details"
  >
    <h2 class="font-heading border-b border-white/10 px-6 py-4 text-xl font-bold text-white">
      Project Details
    </h2>
    <dl class="divide-y divide-white/10">
      {specs.map((spec) => (
        <div class="flex items-baseline justify-between gap-4 px-6 py-4">
          <dt class="text-sm font-semibold uppercase tracking-wide text-primary">{spec.label}</dt>
          <dd class="text-base font-medium text-white text-right" data-tina-field={spec.field}>{spec.value}</dd>
        </div>
      ))}
    </dl>
  </aside>
)}
