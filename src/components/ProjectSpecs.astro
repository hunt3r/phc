---
interface Props {
  location?: string | null;
  client?: string | null;
  date?: string | null;
  projectCost?: string | null;
  size?: string | null;
  architect?: string | null;
  engineer?: string | null;
  contractor?: string | null;
  class?: string;
  /** `data-tina-field` values so the live preview can focus each spec. */
  fields?: {
    location?: string;
    client?: string;
    date?: string;
    projectCost?: string;
    size?: string;
    architect?: string;
    engineer?: string;
    contractor?: string;
  };
}

const {
  location,
  client,
  date,
  projectCost,
  size,
  architect,
  engineer,
  contractor,
  class: className,
  fields,
} = Astro.props as Props;

const specs = [
  { label: 'Location', value: location, field: fields?.location },
  { label: 'Client', value: client, field: fields?.client },
  { label: 'Date', value: date, field: fields?.date },
  { label: 'Project Cost', value: projectCost, field: fields?.projectCost },
  { label: 'Size', value: size, field: fields?.size },
  { label: 'Architect', value: architect, field: fields?.architect },
  { label: 'Engineer', value: engineer, field: fields?.engineer },
  { label: 'Contractor', value: contractor, field: fields?.contractor },
].filter((spec) => spec.value && spec.value.trim().length > 0);
---

{specs.length > 0 && (
  <aside
    class:list={[
      'not-prose @container overflow-hidden rounded-xl border border-[#2a4258] bg-[#101922] text-[#f7f4ee] shadow-md shadow-black/15',
      className,
    ]}
    aria-label="Project details"
  >
    <h2 class="font-heading relative m-0 bg-gradient-to-b from-[#14588a] via-[#0d3f66] to-[#101922] px-5 pb-3.5 pt-4 text-lg font-semibold tracking-tight text-white">
      Project Details
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-[#e8d49a] to-transparent"
      />
    </h2>
    <dl class="m-0 divide-y divide-white/10">
      {specs.map((spec) => (
        <div class="bg-[#101922] px-5 py-3 @min-[18.5rem]:flex @min-[18.5rem]:items-baseline @min-[18.5rem]:gap-3">
          <dt class="subheading m-0 text-[0.6875rem] font-semibold leading-5 text-[#f0e0b0] @min-[18.5rem]:w-[6.75rem] @min-[18.5rem]:shrink-0">
            {spec.label}
          </dt>
          <dd
            class="m-0 mt-0.5 min-w-0 text-[0.9375rem] leading-snug font-medium break-words text-[#f7f4ee] @min-[18.5rem]:mt-0 @min-[18.5rem]:flex-1"
            data-tina-field={spec.field}
          >
            {spec.value}
          </dd>
        </div>
      ))}
    </dl>
  </aside>
)}
