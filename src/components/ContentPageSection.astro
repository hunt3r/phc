---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from './blocks/hero-page.astro';
import VideoGrid from './VideoGrid.astro';
import { getEntry, render } from 'astro:content';
import { toVideoViews } from '@/lib/videos';
import { createBreadcrumbListSchema } from '@/lib/seo/jsonld';

interface Props {
  entryId: string;
  path: string;
  breadcrumbLabel?: string;
  jsonLdNodes?: Record<string, unknown>[];
}

const { entryId, path, breadcrumbLabel, jsonLdNodes: extraJsonLdNodes = [] } = Astro.props;

const entry = await getEntry('pages', entryId);
if (!entry) {
  throw new Error(`Page content not found: ${entryId}. Run: npm run generate:pages`);
}

const { Content } = await render(entry);
const videos = toVideoViews(entry.data.videos, `page-${entryId}`);
const hero = entry.data.hero;
const heroBackgroundImage =
  typeof hero?.backgroundImage === 'string' ? hero.backgroundImage : entry.data.featuredImage;
const label = breadcrumbLabel ?? entry.data.title;
const ogDescription =
  entry.data.description ??
  hero?.subtitle ??
  `${label} — PH&C construction and real estate development consulting.`;
const site = Astro.url.origin || import.meta.env.SITE || 'https://phandc.net';
const jsonLdNodes = [
  createBreadcrumbListSchema(site, [
    { name: 'Home', path: '/' },
    { name: label, path },
  ]),
  ...extraJsonLdNodes,
];
---

<BaseLayout title={entry.data.title} description={ogDescription} image={heroBackgroundImage} jsonLdNodes={jsonLdNodes} ogType="article">
  <HeroPage
    id={`${entryId}-hero`}
    size={hero?.size ?? 'compact'}
    eyebrow={hero?.eyebrow}
    tagline={hero?.tagline ?? entry.data.title}
    subtitle={hero?.subtitle ?? entry.data.description}
    ctaPrimaryText={hero?.ctaPrimaryText}
    ctaPrimaryHref={hero?.ctaPrimaryHref}
    ctaSecondaryText={hero?.ctaSecondaryText}
    ctaSecondaryHref={hero?.ctaSecondaryHref}
    backgroundImage={heroBackgroundImage}
    overlayOpacity={hero?.overlayOpacity ?? 70}
    overlayColor={hero?.overlayColor ?? 'dark'}
  />
  <article class="pt-8">
    <section class="prose-content prose-img:rounded-lg">
      <Content />
    </section>

    {videos.length > 0 && (
      <section class="pt-4 space-y-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Videos</h2>
        <VideoGrid videos={videos} sectionId={`page-${entryId}`} />
      </section>
    )}

    <slot />
  </article>
</BaseLayout>
