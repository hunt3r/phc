---
import BaseLayout from '../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '@/lib/islands';
import HeroPage from './blocks/hero-page.astro';
import PageTitle from './PageTitle.astro';
import VideoGrid from './VideoGrid.astro';
import ContentCards from './ContentCards.astro';
import { getEntry, render } from 'astro:content';
import { toVideoViews } from '@/lib/videos';
import { hasFeaturedImage } from '@/lib/page-header';
import { createBreadcrumbListSchema } from '@/lib/seo/jsonld';

interface Props {
  entryId: string;
  path: string;
  /** Content collection to read from. Defaults to the generic `pages` collection. */
  collection?: 'pages' | 'contact';
  /** Island name for the banner, shown only when Featured Image is set. */
  heroIsland?: string;
  /** Island name for the in-page title, shown only when Featured Image is blank. */
  headingIsland?: string;
  /** Island name for the editable body region. */
  bodyIsland?: string;
  /** Island name for the editable content-cards region. */
  cardsIsland?: string;
  breadcrumbLabel?: string;
  /** Search-result description used when the page has no visible description. */
  metaDescription?: string;
  jsonLdNodes?: Record<string, unknown>[];
}

const {
  entryId,
  path,
  collection = 'pages',
  heroIsland = 'pageHero',
  headingIsland = 'pageHeading',
  bodyIsland = 'page',
  cardsIsland = 'pageCards',
  breadcrumbLabel,
  metaDescription,
  jsonLdNodes: extraJsonLdNodes = [],
} = Astro.props;

const entry = await getEntry(collection, entryId);
if (!entry) {
  throw new Error(`Page content not found: ${collection}/${entryId}`);
}

const { Content } = await render(entry);
const videos = toVideoViews(entry.data.videos, `page-${entryId}`);
// A blank Featured Image drops the banner. The title then sits in the page,
// below the breadcrumb. The hero and heading islands follow the same rule.
const featuredImage = hasFeaturedImage(entry.data.featuredImage)
  ? entry.data.featuredImage.trim()
  : undefined;
const description = entry.data.description?.trim() || undefined;
const label = breadcrumbLabel ?? entry.data.title;
const ogDescription = description || metaDescription;
const site = Astro.url.origin || import.meta.env.SITE || 'https://www.phandc.net';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: label, path },
];
const jsonLdNodes = [
  createBreadcrumbListSchema(site, breadcrumbs),
  ...extraJsonLdNodes,
];
---

<BaseLayout title={entry.data.title} description={ogDescription} image={featuredImage} jsonLdNodes={jsonLdNodes} breadcrumbs={breadcrumbs} ogType="article">
  <TinaIsland slot="hero" name={heroIsland} wrapper={islands[heroIsland].wrapper} params={{ slug: entryId }}>
    {featuredImage && (
      <HeroPage
        id={`${entryId}-hero`}
        size="compact"
        tagline={entry.data.title}
        subtitle={description}
        backgroundImage={featuredImage}
        overlayOpacity={70}
        overlayColor="dark"
      />
    )}
  </TinaIsland>
  <article class="pt-8">
    <TinaIsland name={headingIsland} wrapper={islands[headingIsland].wrapper} params={{ slug: entryId }}>
      {!featuredImage && (
        <PageTitle title={entry.data.title} description={description} />
      )}
    </TinaIsland>

    <slot name="aside" />

    <TinaIsland name={bodyIsland} wrapper={islands[bodyIsland].wrapper} params={{ slug: entryId }} primary>
      <section class="prose-content prose-img:rounded-lg">
        <Content />
      </section>
    </TinaIsland>

    <TinaIsland name={cardsIsland} wrapper={islands[cardsIsland].wrapper} params={{ slug: entryId }}>
      <ContentCards cards={entry.data.contentCards} sectionId={`page-${entryId}-card`} />
    </TinaIsland>

    {videos.length > 0 && (
      <section class="pt-4 space-y-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Videos</h2>
        <VideoGrid videos={videos} sectionId={`page-${entryId}`} />
      </section>
    )}

    <div class="clear-both">
      <slot />
    </div>
  </article>
</BaseLayout>
