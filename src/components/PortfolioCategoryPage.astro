---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import PortfolioNav from './PortfolioNav.astro';
import VideoGrid from './VideoGrid.astro';
import { getImageUrl } from '@/lib/cloudinary';
import {
  getTagMap,
  portfolioEntriesForTagTree,
  childrenOf,
  tagHref,
} from '@/lib/tags';
import { toVideoViews } from '@/lib/videos';
import { createBreadcrumbListSchema } from '@/lib/seo/jsonld';

interface Props {
  entry: CollectionEntry<'tags'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tagLabel = entry.data.label;

const portfolio = await getCollection('portfolio');
const tagMap = await getTagMap();
const entries = portfolioEntriesForTagTree(entry.id, portfolio, tagMap).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);
const childTags = childrenOf(entry.id, tagMap);

const videos = toVideoViews(entry.data.videos, `sector-${entry.id}`);

const HERO_WIDTHS = [640, 960, 1200, 1600];
const heroImageUrl = entry.data.image
  ? getImageUrl(entry.data.image, { width: 1600, quality: 'auto:eco' })
  : undefined;
const heroImageSrcSet = entry.data.image
  ? HERO_WIDTHS.map((width) => `${getImageUrl(entry.data.image, { width, quality: 'auto:eco' })} ${width}w`).join(', ')
  : undefined;

const ogDescription = entry.data.description
  ? entry.data.description.slice(0, 160).trim()
  : undefined;
const site = Astro.url.origin || import.meta.env.SITE || 'https://phandc.net';
const jsonLdNodes = [
  createBreadcrumbListSchema(site, [
    { name: 'Home', path: '/' },
    { name: 'Portfolio', path: '/portfolio' },
    { name: tagLabel, path: `/portfolio/${entry.id}` },
  ]),
];
---

<BaseLayout title={tagLabel} description={ogDescription} image={entry.data.image} jsonLdNodes={jsonLdNodes}>
  {heroImageUrl && (
    <img
      src={heroImageUrl}
      srcset={heroImageSrcSet}
      sizes="(max-width: 1152px) 100vw, 1152px"
      alt={tagLabel}
      width="1600"
      height="686"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="mt-8 aspect-[21/9] w-full rounded-lg object-cover"
    />
  )}

  <div class="pt-8 flex flex-col gap-8 lg:flex-row lg:gap-12">
    <PortfolioNav activeId={entry.id} />

    <div class="min-w-0 flex-1 space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">{tagLabel}</h1>
        {entry.data.description && (
          <p class="mt-1 text-gray-600 dark:text-gray-400">{entry.data.description}</p>
        )}
      </div>

      <section class="prose-content">
        <Content />
      </section>

      {childTags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {childTags.map((child) => (
            <a
              href={tagHref(child.id, tagMap)}
              class="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-sm font-medium text-gray-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:border-primary dark:hover:bg-primary/10"
            >
              {child.data.label}
            </a>
          ))}
        </div>
      )}

      <div>
        <p class="text-gray-600 dark:text-gray-400">
          {entries.length} project{entries.length === 1 ? '' : 's'}
        </p>
      </div>

      {entries.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
          {entries.map((portfolioEntry) => (
            <li>
              <ProjectCard
                title={portfolioEntry.data.title ?? ''}
                description={portfolioEntry.data.description ?? ''}
                href={`/portfolio/${portfolioEntry.id}`}
                imageSrc={portfolioEntry.data.image}
                imageAlt={portfolioEntry.data.title ?? ''}
                date={portfolioEntry.data.date}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-gray-600 dark:text-gray-400">No projects in this sector yet.</p>
      )}

      {videos.length > 0 && (
        <section class="space-y-6">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Videos</h2>
          <VideoGrid videos={videos} sectionId={`sector-${entry.id}`} />
        </section>
      )}
    </div>
  </div>
</BaseLayout>
