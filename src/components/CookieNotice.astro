---
import { getEntry } from 'astro:content';
import { renderCardContent } from '@/lib/contentCard';

interface Props {
  measurementId: string;
}

const { measurementId } = Astro.props;

const DEFAULT_COOKIE_NOTICE =
  'PH&C uses a cookie to count visits. [Privacy Policy](/privacy-policy)';

const site = await getEntry('site', 'index');
const copyClass =
  'text-sm text-gray-700 dark:text-gray-300 [&_p]:m-0 [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-primary/80';

function hasVisibleText(html: string): boolean {
  return html.replace(/<[^>]+>/g, '').replace(/&nbsp;/gi, ' ').trim().length > 0;
}

let messageHtml = await renderCardContent(site?.data?.cookieNotice);
if (!hasVisibleText(messageHtml)) {
  messageHtml = await renderCardContent(DEFAULT_COOKIE_NOTICE);
}
---

<div
  id="cookie-notice"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-gray-200 bg-white shadow-md dark:border-gray-700 dark:bg-[#0a0a0a]"
  role="region"
  aria-label="Cookie notice"
  data-measurement-id={measurementId}
  hidden
>
  <div class="mx-auto flex max-w-8xl flex-col gap-4 px-4 py-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div>
      <div class={copyClass} data-cookie-ask set:html={messageHtml} />
      <div class={copyClass} data-cookie-settings-copy hidden>
        <p class="m-0"><span data-cookie-state></span></p>
        <div class="mt-2" set:html={messageHtml} />
      </div>
    </div>
    <div class="flex flex-wrap justify-center gap-2 sm:justify-end">
      <button type="button" class="btn btn-secondary" data-cookie-deny>Opt out</button>
      <button type="button" class="btn btn-primary" data-cookie-allow>OK</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var notice = document.getElementById('cookie-notice');
    if (!notice) return;

    var askCopy = notice.querySelector('[data-cookie-ask]');
    var settingsCopy = notice.querySelector('[data-cookie-settings-copy]');
    var stateCopy = notice.querySelector('[data-cookie-state]');
    var denyButton = notice.querySelector('[data-cookie-deny]');
    var allowButton = notice.querySelector('[data-cookie-allow]');
    var measurementId = notice.getAttribute('data-measurement-id') || '';

    function choice() {
      var match = document.cookie.match(/(?:^|; )phc_analytics=(granted|denied)(?:;|$)/);
      return match ? match[1] : '';
    }

    function gpc() {
      return navigator.globalPrivacyControl === true;
    }

    function analyticsOn() {
      var stored = choice();
      if (stored === 'granted') return true;
      if (stored === 'denied') return false;
      return !gpc();
    }

    function writeChoice(value) {
      var secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = 'phc_analytics=' + value + '; Max-Age=31536000; Path=/; SameSite=Lax' + secure;
    }

    function clearAnalyticsCookies() {
      var names = [];
      var seen = {};
      function add(name) {
        if (!name || seen[name]) return;
        seen[name] = true;
        names.push(name);
      }
      add('_ga');
      if (measurementId.indexOf('G-') === 0) add('_ga_' + measurementId.slice(2));
      document.cookie.split(';').forEach(function (part) {
        var name = part.split('=')[0].trim();
        if (name === '_ga' || name.indexOf('_ga_') === 0) add(name);
      });
      var host = location.hostname;
      var domains = [''];
      if (host) {
        domains.push(host);
        domains.push('.' + host);
      }
      if (host === 'phandc.net' || host.endsWith('.phandc.net')) domains.push('.phandc.net');
      names.forEach(function (name) {
        domains.forEach(function (domain) {
          var cookie = name + '=; Max-Age=0; Path=/';
          if (domain) cookie += '; Domain=' + domain;
          document.cookie = cookie;
        });
      });
    }

    function syncPadding() {
      document.body.style.paddingBottom = notice.hidden ? '' : notice.offsetHeight + 'px';
    }

    function hide() {
      notice.hidden = true;
      syncPadding();
      var opener = document.querySelector('[data-cookie-settings]');
      if (opener && notice.contains(document.activeElement)) opener.focus();
    }

    function show(mode) {
      var asking = mode === 'ask';
      askCopy.hidden = !asking;
      settingsCopy.hidden = asking;
      stateCopy.textContent = analyticsOn() ? 'Analytics cookies are on.' : 'Analytics cookies are off.';
      allowButton.textContent = asking ? 'OK' : 'Allow analytics';
      notice.hidden = false;
      syncPadding();
      if (!asking) denyButton.focus();
    }

    function apply(next) {
      var on = analyticsOn();
      var stored = choice();
      if (next === 'granted' && on && (stored === 'granted' || (!stored && !gpc()))) {
        writeChoice('granted');
        hide();
        return;
      }
      if (next === 'denied' && !on && stored === 'denied') {
        hide();
        return;
      }
      writeChoice(next);
      if (next === 'denied') clearAnalyticsCookies();
      location.reload();
    }

    denyButton.addEventListener('click', function () { apply('denied'); });
    allowButton.addEventListener('click', function () { apply('granted'); });
    document.addEventListener('click', function (event) {
      var opener = event.target.closest('[data-cookie-settings]');
      if (!opener) return;
      show('settings');
    });
    window.addEventListener('resize', syncPadding);

    if (!analyticsOn()) clearAnalyticsCookies();
    if (!choice() && !gpc()) show('ask');
  })();
</script>
