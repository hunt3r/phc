---
import { getImageUrl, isCloudinarySrc } from '@/lib/cloudinary';

const CARD_WIDTHS = [320, 480, 640, 960];
const CARD_SIZES = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1280px) 33vw, 25vw';

interface Props {
  name: string;
  title: string;
  href: string;
  /** Optional profile photo path or Cloudinary URL */
  image?: string;
}

const { name, title, href, image } = Astro.props;
const imageUrl = image ? getImageUrl(image, { width: 640, height: 640, crop: 'fill' }) : undefined;
const imageSrcSet =
  image && isCloudinarySrc(image)
    ? CARD_WIDTHS.map(
        (width) => `${getImageUrl(image, { width, height: width, crop: 'fill' })} ${width}w`
      ).join(', ')
    : undefined;
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white text-gray-900 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100"
>
  <div class="flex aspect-square w-full items-center justify-center overflow-hidden bg-gray-100 text-3xl font-semibold text-gray-500 dark:bg-gray-700 dark:text-gray-400">
    {imageUrl ? (
      <img
        src={imageUrl}
        srcset={imageSrcSet}
        sizes={CARD_SIZES}
        alt=""
        class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
        width="640"
        height="640"
        loading="lazy"
      />
    ) : (
      initials
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-5">
    <h3 class="text-base font-semibold tracking-tight text-gray-900 dark:text-gray-100">{name}</h3>
    <p class="text-sm text-primary">{title}</p>
  </div>
</a>
