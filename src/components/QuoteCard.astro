---
interface Props {
  quote: string;
  author?: string;
  role?: string;
  projectTitle?: string;
  projectHref?: string;
  class?: string;
}

const { quote, author, role, projectTitle, projectHref, class: className } = Astro.props as Props;
---

<figure
  class={`flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 text-gray-900 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 ${className ?? ""}`}
>
  <svg class="h-8 w-8 shrink-0 text-primary/40" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
  </svg>
  <blockquote class="mt-4 flex-1 text-base leading-relaxed text-gray-700 dark:text-gray-300">
    {quote}
  </blockquote>
  <figcaption class="mt-6 border-t border-gray-100 pt-4 text-sm dark:border-gray-700">
    {author && (
      <span class="block font-semibold text-gray-900 dark:text-gray-100">{author}</span>
    )}
    {role && (
      <span class="block text-gray-600 dark:text-gray-400">{role}</span>
    )}
    {projectTitle && projectHref && (
      <a
        href={projectHref}
        class="mt-2 inline-flex items-center gap-1 font-medium text-primary hover:underline"
      >
        <span>{projectTitle}</span>
        <span aria-hidden="true">→</span>
      </a>
    )}
  </figcaption>
</figure>
