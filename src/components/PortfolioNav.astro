---
import { getNavTree } from '@/lib/tags';
import LeftNav from './LeftNav.astro';

interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;
const navTree = await getNavTree();
---

<LeftNav
  navTree={navTree}
  activeId={activeId}
  label="Sections"
  rootHref="/portfolio"
  rootLabel="All"
  selectId="portfolio-tag-mobile"
/>
