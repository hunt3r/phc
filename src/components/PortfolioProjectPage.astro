---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '@/lib/islands';
import PortfolioGallery from './PortfolioGallery.astro';
import ProjectCover from './ProjectCover.astro';
import ProjectSpecs from './ProjectSpecs.astro';
import ProjectTagLinks from './ProjectTagLinks.astro';
import QuoteCard from './QuoteCard.astro';
import VideoGrid from './VideoGrid.astro';
import ContentCards from './ContentCards.astro';
import { getTagMap, resolveTags, resolveTagsGrouped } from '@/lib/tags';
import { getEntityMap, resolveCredits } from '@/lib/entities';
import { leadingSentences, metaDescription } from '@/lib/seo/metaDescription';
import { toVideoViews } from '@/lib/videos';
import {
  createBreadcrumbListSchema,
  createPortfolioCreativeWorkSchema,
  toAbsoluteUrl,
  toCanonicalUrl,
} from '@/lib/seo/jsonld';

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const tagMap = await getTagMap();
const entityMap = await getEntityMap();
const resolvedTags = resolveTags(entry, tagMap);
const tagGroups = resolveTagsGrouped(entry, tagMap);
const client = resolveCredits(entry.data.client, entityMap);
const architect = resolveCredits(entry.data.architect, entityMap);
const engineer = resolveCredits(entry.data.engineer, entityMap);
const contractor = resolveCredits(entry.data.contractor, entityMap);

const videos = toVideoViews(entry.data.videos, `portfolio-${entry.id}`);

// Use gallery from frontmatter, or fall back to hero image so the gallery section always shows when we have an image
const galleryImages =
  entry.data.gallery && entry.data.gallery.length > 0
    ? entry.data.gallery
    : entry.data.image
      ? [{ src: entry.data.image, alt: entry.data.title ?? '' }]
      : [];

// Spec lists and long narratives make poor search snippets, so the snippet is the
// project name plus its sector, with a leading sentence from the write-up when one fits.
const sectorLabel = (entry.data.sectors ?? [])
  .map((id) => tagMap.get(id)?.data.label)
  .find(Boolean);
const projectFallback = `${entry.data.title}: ${sectorLabel ? `${sectorLabel.toLowerCase()} project` : 'project'} with PH&C, an owner's representative and construction management firm.`;
const leadSentence = leadingSentences(entry.data.description ?? '', 155 - entry.data.title.length - 2);
const ogDescription = metaDescription(
  leadSentence.length >= 40 ? `${entry.data.title}: ${leadSentence}` : undefined,
  entry.data.title,
  projectFallback
);
const site = Astro.url.origin || import.meta.env.SITE || "https://www.phandc.net";
const pageUrl = toCanonicalUrl(Astro.url.pathname, site);
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Portfolio", path: "/portfolio" },
  { name: entry.data.title, url: pageUrl },
];
const jsonLdNodes = [
  createBreadcrumbListSchema(site, breadcrumbs),
  createPortfolioCreativeWorkSchema(site, {
    url: pageUrl,
    name: entry.data.title,
    description: ogDescription,
    image: entry.data.image ? toAbsoluteUrl(entry.data.image, site) : undefined,
    date: entry.data.date,
    location: entry.data.location,
    clients: client,
    tags: resolvedTags.map((t) => t.label),
  }),
];
---

<BaseLayout title={entry.data.title} description={ogDescription} image={entry.data.image} jsonLdNodes={jsonLdNodes} breadcrumbs={breadcrumbs} ogType="article" datePublished={entry.data.date}>
  <TinaIsland slot="hero" name="portfolioHero" wrapper={islands.portfolioHero.wrapper} params={{ slug: entry.id }}>
    <ProjectCover image={entry.data.image} title={entry.data.title} />
  </TinaIsland>
  <TinaIsland name="portfolio" wrapper={islands.portfolio.wrapper} params={{ slug: entry.id }} primary>
  <article class="space-y-8">
    <h1 class="mt-4 text-3xl font-bold text-gray-900 dark:text-gray-100">{entry.data.title}</h1>
    <section class="prose-content [&::after]:clear-both [&::after]:table [&::after]:content-['']">
      <ProjectSpecs
        location={entry.data.location}
        client={client}
        date={entry.data.date}
        projectCost={entry.data.projectCost}
        size={entry.data.size}
        architect={architect}
        engineer={engineer}
        contractor={contractor}
        class="mb-6 w-full md:float-right md:mb-4 md:ml-8 md:w-80 lg:w-96"
      />
      <Content />
    </section>

    <ContentCards cards={entry.data.contentCards} sectionId={`portfolio-${entry.id}-card`} />

    {galleryImages.length > 0 && (
      <PortfolioGallery images={galleryImages} galleryId={entry.id} />
    )}

    {entry.data.quotes && entry.data.quotes.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          Testimonials
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {entry.data.quotes.map((q) => (
            <QuoteCard quote={q.quote} author={q.author} role={q.role} />
          ))}
        </div>
      </section>
    )}

    {videos.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          Videos
        </h2>
        <VideoGrid videos={videos} sectionId={`portfolio-${entry.id}`} />
      </section>
    )}

    <ProjectTagLinks groups={tagGroups} />
  </article>
  </TinaIsland>
</BaseLayout>
