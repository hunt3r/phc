---
/**
 * Marks a project card whose Order field pins it in the list.
 * A pushpin, not a map pin: it means the card was placed by hand.
 */
---

<span class="inline-flex rounded-full bg-white/95 p-1.5 text-gray-800 shadow-sm ring-1 ring-black/10 dark:bg-gray-900/90 dark:text-gray-100 dark:ring-white/15" role="img" aria-label="Pinned">
  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 17v5" />
    <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z" />
  </svg>
</span>
