---
interface Props {
  groups: { label: string; tags: { href: string; label: string }[] }[];
}

const { groups } = Astro.props;
---

{groups.length > 0 && (
  <div class="space-y-2">
    {groups.map((group) => (
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
          {group.label}:
        </span>
        {group.tags.map((tag) => (
          <a
            href={tag.href}
            class="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 px-2.5 py-0.5 text-xs font-medium text-gray-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:border-primary dark:hover:bg-primary/10"
          >
            {tag.label}
          </a>
        ))}
      </div>
    ))}
  </div>
)}
